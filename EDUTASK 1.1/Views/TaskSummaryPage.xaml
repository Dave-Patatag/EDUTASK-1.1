<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EDUTASK_1._1.Models"
             x:Class="EDUTASK_1._1.Views.TaskSummaryPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F6FA">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <Grid Padding="22,14,22,18" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" BackgroundColor="White">
            <ImageButton Source="backicon.png" Clicked="OnBackClicked" WidthRequest="30" HeightRequest="30" Padding="5" BackgroundColor="Transparent" HorizontalOptions="Start" SemanticProperties.Description="Go back"/>
            <Label Grid.Row="1" Text="Task Summary Reports" FontSize="20" FontAttributes="Bold" TextColor="#1F2937"/>
            <Grid Grid.Row="1" Grid.Column="1" WidthRequest="135" HorizontalOptions="End">
                <Picker x:Name="PeriodPicker" SelectedIndexChanged="OnPeriodChanged"
                        FontSize="11" TextColor="#7A8491" HorizontalOptions="Fill"/>
                <Label Text="&#x25BE;" FontSize="12" TextColor="#7A8491" HorizontalOptions="End"
                       VerticalOptions="Center" Margin="0,0,8,0" InputTransparent="True"/>
            </Grid>
            <Label x:Name="ReportDateLabel" Grid.Row="2" FontSize="10" TextColor="#9AA4AF">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnReportDateTapped"/></Label.GestureRecognizers>
            </Label>
        </Grid>
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="22,16,22,24" Spacing="14">
                <Border Padding="4" BackgroundColor="#E5EBF2" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                        <Button x:Name="OverviewTabButton" Text="Overview" Clicked="OnOverviewTabClicked" HeightRequest="34"
                                FontSize="11" FontAttributes="Bold" CornerRadius="17" BackgroundColor="#5D6D7E" TextColor="White"/>
                        <Button x:Name="TasksTabButton" Grid.Column="1" Text="Tasks" Clicked="OnTasksTabClicked" HeightRequest="34"
                                FontSize="11" FontAttributes="Bold" CornerRadius="17" BackgroundColor="Transparent" TextColor="#596574"/>
                    </Grid>
                </Border>
                <Grid x:Name="TeacherFilterRow" ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="False">
                    <Label Text="TEACHER" FontSize="10" FontAttributes="Bold" TextColor="#687786" VerticalOptions="Center"/>
                    <Border Grid.Column="1" HorizontalOptions="End" WidthRequest="170" Padding="10,0"
                            BackgroundColor="White" Stroke="#DCE4ED">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Grid>
                            <Picker x:Name="TeacherPicker" SelectedIndexChanged="OnTeacherChanged" FontSize="11"
                                    TextColor="#374151" HorizontalOptions="Fill"/>
                            <Label Text="&#x25BE;" FontSize="11" TextColor="#7A8491" HorizontalOptions="End"
                                   VerticalOptions="Center" InputTransparent="True"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="SummaryCards" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border x:Name="TotalCard" Grid.Column="3" BackgroundColor="White" Stroke="#DCE4ED" Padding="5,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label x:Name="TotalCountLabel" FontSize="19" FontAttributes="Bold" TextColor="#243447" HorizontalTextAlignment="Center"/>
                            <Label Text="Total" FontSize="9" TextColor="#7A8491"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSummaryCardTapped" CommandParameter="All"/></Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="CompletedCard" Grid.Column="1" BackgroundColor="White" Stroke="#DCE4ED" Padding="5,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label x:Name="CompletedCountLabel" FontSize="19" FontAttributes="Bold" TextColor="#16803A" HorizontalTextAlignment="Center"/>
                            <Label Text="Completed" FontSize="9" TextColor="#7A8491"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSummaryCardTapped" CommandParameter="Completed"/></Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="PendingCard" Grid.Column="0" BackgroundColor="White" Stroke="#DCE4ED" Padding="5,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label x:Name="PendingCountLabel" FontSize="19" FontAttributes="Bold" TextColor="#2563EB" HorizontalTextAlignment="Center"/>
                            <Label Text="Pending" FontSize="9" TextColor="#7A8491"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSummaryCardTapped" CommandParameter="Pending"/></Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="OverdueCard" Grid.Column="2" BackgroundColor="White" Stroke="#DCE4ED" Padding="5,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label x:Name="OverdueCountLabel" FontSize="19" FontAttributes="Bold" TextColor="#B42318" HorizontalTextAlignment="Center"/>
                            <Label Text="Overdue" FontSize="9" TextColor="#7A8491"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSummaryCardTapped" CommandParameter="Overdue"/></Border.GestureRecognizers>
                    </Border>
                </Grid>
                <VerticalStackLayout x:Name="CompletionSection" Spacing="4" Padding="0,4">
                    <Label Text="Completion" FontSize="12" FontAttributes="Bold" TextColor="#374151"/>
                    <Grid WidthRequest="180" HeightRequest="180" HorizontalOptions="Center">
                        <GraphicsView x:Name="CompletionRing"/>
                        <Label x:Name="CompletionPercentLabel" FontSize="30" FontAttributes="Bold" TextColor="#2563EB"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="StatusSection" Spacing="7">
                    <Label Text="ACTION REQUIRED" FontSize="10" FontAttributes="Bold" TextColor="#687786"/>
                    <Border Padding="14,12" BackgroundColor="White" Stroke="#E1E5EA">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout x:Name="ValidationMetric" Spacing="2" IsVisible="False">
                                <Label x:Name="StatusValidationLabel" FontSize="16" FontAttributes="Bold" TextColor="#6554C0"/>
                                <Label Text="For validation" FontSize="9" TextColor="#596574"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="RevisionMetric" Grid.Column="1" Spacing="2" IsVisible="False">
                                <Label x:Name="StatusRevisionLabel" FontSize="16" FontAttributes="Bold" TextColor="#DC2626"/>
                                <Label Text="Needs revision" FontSize="9" TextColor="#596574"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="TeacherSection" Spacing="7">
                    <Label Text="TEACHER PERFORMANCE" FontSize="10" FontAttributes="Bold" TextColor="#687786"/>
                    <VerticalStackLayout x:Name="TeacherSummaryList" BindableLayout.ItemsSource="{Binding TeacherSummaries}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TeacherSummaryItem">
                                <Border Padding="14,11" BackgroundColor="White" Stroke="#DCE4ED">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                        <Label Text="{Binding TeacherName}" FontSize="11" FontAttributes="Bold" TextColor="#243447"/>
                                        <Label Grid.Column="1" Text="{Binding PercentDisplay}" FontSize="10" FontAttributes="Bold" TextColor="#2563EB"/>
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="{Binding CompletionRate}" HeightRequest="5"
                                                     ProgressColor="#2563EB" BackgroundColor="#E5E7EB"/>
                                        <Label Grid.Row="2" Text="{Binding CompletionDisplay}" FontSize="9" TextColor="#7A8491"/>
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding OverdueCount, StringFormat='{0} overdue'}" FontSize="9" TextColor="#A33A32"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="TasksSection" IsVisible="False" Spacing="5">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="TASKS" FontSize="10" FontAttributes="Bold" TextColor="#687786"/>
                            <Label x:Name="ActiveStatusFilterLabel" Text="Showing: All tasks" FontSize="10" TextColor="#596574"/>
                        </VerticalStackLayout>
                        <Button x:Name="ClearStatusFilterButton" Grid.Column="1" Text="Clear" Clicked="OnClearStatusFilterClicked"
                                IsVisible="False" FontSize="10" FontAttributes="Bold" HeightRequest="30" Padding="12,0"
                                CornerRadius="15" BackgroundColor="#E5EBF2" TextColor="#374151"/>
                    </Grid>
                    <Label x:Name="EmptyReportLabel" Text="No tasks found for this period." IsVisible="False"
                           Padding="4,18" HorizontalTextAlignment="Center" FontSize="11" TextColor="#9AA4AF"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReportTasks}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskSummaryItem">
                                <Border Padding="12,10" BackgroundColor="White" Stroke="#DCE4ED">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                        <Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" TextColor="#243447"/>
                                        <Label Grid.Column="1" Text="{Binding Status}" FontSize="9" FontAttributes="Bold" TextColor="{Binding StatusColor}"/>
                                        <Label Grid.Row="1" Text="{Binding TeacherName}" FontSize="9" TextColor="#596574"/>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DeadlineDisplay, StringFormat='Due {0}'}" FontSize="9" TextColor="#7A8491"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTaskTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="#687786"/>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Padding="0,16,0,10" BackgroundColor="White">
            <Grid.Resources>
                <Style TargetType="Image">
                    <Setter Property="WidthRequest" Value="24"/>
                    <Setter Property="HeightRequest" Value="24"/>
                    <Setter Property="HorizontalOptions" Value="Center"/>
                </Style>
            </Grid.Resources>
            <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="#E5E7EB" VerticalOptions="Start"/>
            <Image Grid.Column="0" Source="task.png" Margin="0,7,0,0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                </Image.GestureRecognizers>
            </Image>
            <Image Grid.Column="1" Source="notificationbell.png" Margin="0,7,0,0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificationsTapped"/>
                </Image.GestureRecognizers>
            </Image>
            <Image Grid.Column="2" Source="personicon.png" Margin="0,7,0,0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped"/>
                </Image.GestureRecognizers>
            </Image>
        </Grid>
        <Grid x:Name="TaskDetailOverlay" Grid.RowSpan="3" IsVisible="False" ZIndex="11" BackgroundColor="#66000000" Padding="24">
            <Border WidthRequest="370" Padding="20" BackgroundColor="White" Stroke="#D7DCE2"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Task details" FontSize="18" FontAttributes="Bold" TextColor="#243447"/>
                        <Button Grid.Column="1" Text="&#x2715;" Clicked="OnTaskDetailCloseClicked" WidthRequest="30" HeightRequest="30"
                                Padding="0" FontSize="14" BackgroundColor="Transparent" TextColor="#687786"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E5E7EB"/>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="TASK" FontSize="9" FontAttributes="Bold" TextColor="#7A8491"/>
                        <Label x:Name="TaskModalTitleLabel" FontSize="16" FontAttributes="Bold" TextColor="#243447"/>
                    </VerticalStackLayout>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="5">
                        <Label Text="ASSIGNED TO" FontSize="9" FontAttributes="Bold" TextColor="#7A8491"/>
                        <Label Grid.Column="1" Text="STATUS" FontSize="9" FontAttributes="Bold" TextColor="#7A8491"/>
                        <Label x:Name="TaskModalTeacherLabel" Grid.Row="1" FontSize="12" TextColor="#374151"/>
                        <Label x:Name="TaskModalStatusLabel" Grid.Row="1" Grid.Column="1" FontSize="12" FontAttributes="Bold"/>
                    </Grid>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="DEADLINE" FontSize="9" FontAttributes="Bold" TextColor="#7A8491"/>
                        <Label x:Name="TaskModalDueDateLabel" FontSize="12" TextColor="#374151"/>
                    </VerticalStackLayout>
                    <Button Text="Close" Clicked="OnTaskDetailCloseClicked" HeightRequest="40" CornerRadius="10"
                            BackgroundColor="#5D6D7E" TextColor="White" FontAttributes="Bold" FontSize="12"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid x:Name="CustomDateOverlay" Grid.RowSpan="3" IsVisible="False" ZIndex="10" BackgroundColor="#66000000" Padding="24">
            <Border WidthRequest="380" Padding="20" BackgroundColor="White" Stroke="#D7DCE2"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Select date range" FontSize="19" FontAttributes="Bold" TextColor="#243447"/>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="5">
                        <Label Text="FROM" FontSize="9" FontAttributes="Bold" TextColor="#687786"/>
                        <Label Grid.Column="1" Text="TO" FontSize="9" FontAttributes="Bold" TextColor="#687786"/>
                        <DatePicker x:Name="StartDatePicker" Grid.Row="1" DateSelected="OnCustomDateChanged"
                                    Format="dd MMMM, yyyy" FontSize="11" BackgroundColor="#F3F6FA" TextColor="#243447"/>
                        <DatePicker x:Name="EndDatePicker" Grid.Row="1" Grid.Column="1" DateSelected="OnCustomDateChanged"
                                    Format="dd MMMM, yyyy" FontSize="11" BackgroundColor="#F3F6FA" TextColor="#243447"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Cancel" Clicked="OnCustomDateCancelClicked" HeightRequest="40" CornerRadius="8"
                                BackgroundColor="#E9EDF2" TextColor="#374151" FontAttributes="Bold" FontSize="12"/>
                        <Button Grid.Column="1" Text="Apply" Clicked="OnCustomDateApplyClicked" HeightRequest="40" CornerRadius="8"
                                BackgroundColor="#5D6D7E" TextColor="White" FontAttributes="Bold" FontSize="12"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
