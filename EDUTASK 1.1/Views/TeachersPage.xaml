<?xml version="1.0" encoding="utf-8" ?>

<base:EduTaskPage
    xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EDUTASK_1._1.Views"
    xmlns:models="clr-namespace:EDUTASK_1._1.Models"
    x:Class="EDUTASK_1._1.Views.TeachersPage"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource SurfaceMuted}">


    <!-- ========================================================= -->
    <!-- PAGE ROOT                                                  -->
    <!-- ========================================================= -->

    <Grid RowDefinitions="Auto,Auto,*,Auto">


        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Grid
            x:Name="PageHeader"
            Padding="15,13"
            ColumnDefinitions="42,*,42"
            BackgroundColor="{StaticResource SurfaceMuted}">


            <!-- FLYOUT MENU: same placement and design as Tasks. -->

            <local:FlyoutMenuButton/>


            <!-- PAGE TITLE -->

            <Label
                x:Name="HeaderTitleLabel"
                Grid.Column="1"
                Text="User Management"
                FontSize="{StaticResource FontHeading}"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                SemanticProperties.HeadingLevel="Level1"/>


            <!-- PAGE MENU -->

            <ImageButton
                x:Name="MenuButton"
                Grid.Column="2"
                Source="dotmenu.png"
                Clicked="OnPageMenuClicked"
                Pressed="OnHeaderMenuPressed"
                Released="OnHeaderMenuReleased"
                WidthRequest="42"
                HeightRequest="42"
                Padding="10"
                CornerRadius="21"
                BackgroundColor="{StaticResource SurfaceBase}"
                BorderWidth="0"
                HorizontalOptions="End"
                VerticalOptions="Center"
                SemanticProperties.Description="Directory menu"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- FILTER + SEARCH                                       -->
        <!-- ===================================================== -->

        <Grid
            x:Name="FilterRow"
            Grid.Row="1"
            Padding="14,12,14,8"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8"
            BackgroundColor="{StaticResource SurfaceMuted}">


            <!-- ================================================= -->
            <!-- ALL DROPDOWN                                      -->
            <!-- FIXED DARK BLUE                                   -->
            <!-- ================================================= -->

            <Border
                x:Name="ScopePill"
                Style="{StaticResource FilterPill}"
                BackgroundColor="#111C3A"
                Stroke="Transparent"
                StrokeThickness="0">

                <Grid
                    ColumnDefinitions="Auto,Auto"
                    ColumnSpacing="6">


                    <!-- ALL TEXT -->

                    <Label
                        x:Name="ScopePillLabel"
                        Text="All"
                        Style="{StaticResource FilterPillLabel}"
                        TextColor="#FFFFFF"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"/>


                    <!-- DROPDOWN ARROW -->

                    <Label
                        x:Name="ScopePillChevron"
                        Grid.Column="1"
                        Text="&#x25BC;"
                        Style="{StaticResource FilterPillChevron}"
                        TextColor="#FFFFFF"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"/>

                </Grid>


                <!-- KEEP EXISTING DROPDOWN FUNCTION -->

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="OnScopeFilterTapped"/>

                </Border.GestureRecognizers>

            </Border>


            <!-- ================================================= -->
            <!-- SEARCH                                            -->
            <!-- ================================================= -->

            <Border
                x:Name="SearchBorder"
                Grid.Column="1"
                HeightRequest="42"
                Padding="12,0"
                BackgroundColor="{StaticResource SurfaceBase}"
                Stroke="{StaticResource BorderStrong}"
                StrokeThickness="1">

                <Border.StrokeShape>

                    <RoundRectangle CornerRadius="10"/>

                </Border.StrokeShape>


                <Grid
                    ColumnDefinitions="*,18"
                    ColumnSpacing="8">


                    <!-- SEARCH ENTRY -->

                    <Entry
                        x:Name="SearchEntry"
                        Style="{StaticResource SearchFieldEntry}"
                        Placeholder="Search by name"
                        VerticalTextAlignment="Center"
                        VerticalOptions="Fill"
                        Margin="0"
                        TextChanged="OnSearchTextChanged"/>


                    <!-- SEARCH ICON -->

                    <Image
                        Grid.Column="1"
                        Source="search.png"
                        WidthRequest="16"
                        HeightRequest="16"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                </Grid>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- DIRECTORY LIST                                        -->
        <!-- ===================================================== -->

        <RefreshView
            x:Name="DirectoryRefresh"
            Grid.Row="2"
            Refreshing="OnRefresh"
            BackgroundColor="{StaticResource SurfaceMuted}"
            Padding="0,2,0,6">

            <Grid>


                <!-- ================================================= -->
                <!-- ACCOUNT LIST                                      -->
                <!-- ================================================= -->

                <CollectionView
                    x:Name="DirectoryView"
                    Margin="{StaticResource CardListMargin}"
                    SelectionMode="None"
                    ItemsUpdatingScrollMode="KeepScrollOffset">


                    <CollectionView.ItemsLayout>

                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="3"/>

                    </CollectionView.ItemsLayout>


                    <!-- ================================================= -->
                    <!-- ACCOUNT CARD                                      -->
                    <!-- ================================================= -->

                    <CollectionView.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:DirectoryCardItem">


                            <Border
                                Style="{StaticResource ListCard}"
                                MinimumHeightRequest="62">


                                <!-- KEEP EXISTING CARD TAP -->

                                <Border.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="OnAccountCardTapped"/>

                                </Border.GestureRecognizers>


                                <Grid
                                    ColumnDefinitions="40,*,Auto"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="10"
                                    RowSpacing="1">


                                    <!-- ================================================= -->
                                    <!-- INITIAL CIRCLE                                    -->
                                    <!-- FIXED DARK BLUE                                   -->
                                    <!-- ================================================= -->

                                    <Border
                                        Grid.RowSpan="2"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        BackgroundColor="#111C3A"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">

                                        <Border.StrokeShape>

                                            <RoundRectangle CornerRadius="20"/>

                                        </Border.StrokeShape>


                                        <!-- INITIALS -->

                                        <Label
                                            Text="{Binding Initials}"
                                            FontSize="{StaticResource FontBodySmall}"
                                            FontAttributes="Bold"
                                            TextColor="#FFFFFF"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"/>

                                    </Border>


                                    <!-- ================================================= -->
                                    <!-- FULL NAME                                         -->
                                    <!-- ================================================= -->

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding FullName}"
                                        FontSize="{StaticResource FontSubheading}"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="TailTruncation"
                                        VerticalTextAlignment="End"/>


                                    <!-- ================================================= -->
                                    <!-- USERNAME                                          -->
                                    <!-- ================================================= -->

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding UsernameDisplay}"
                                        FontSize="{StaticResource FontCaption}"
                                        TextColor="{StaticResource TextTertiary}"
                                        LineBreakMode="TailTruncation"
                                        VerticalTextAlignment="Start"/>


                                    <!-- ================================================= -->
                                    <!-- ACTIVE / STATUS                                   -->
                                    <!-- MOVED DOWN 6PX                                    -->
                                    <!-- ================================================= -->

                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        IsVisible="{Binding ShowBadge}"
                                        Padding="0"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="End"
                                        VerticalOptions="End">

                                        <Border.StrokeShape>

                                            <RoundRectangle CornerRadius="11"/>

                                        </Border.StrokeShape>


                                        <Label
                                            Text="{Binding BadgeText}"
                                            FontSize="{StaticResource FontMicro}"
                                            FontAttributes="Bold"
                                            TextColor="{Binding BadgeColor}"
                                            VerticalTextAlignment="Center"
                                            VerticalOptions="Center"
                                            TranslationY="-10"/>

                                    </Border>


                                    <!-- ================================================= -->
                                    <!-- APPROVE BUTTON                                    -->
                                    <!-- ================================================= -->

                                    <Button
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        Text="Approve"
                                        IsVisible="{Binding ShowApprove}"
                                        Clicked="OnApprove"
                                        CommandParameter="{Binding .}"
                                        FontSize="{StaticResource FontLabel}"
                                        BackgroundColor="{StaticResource StatusSuccess}"
                                        TextColor="{StaticResource TextInverse}"
                                        CornerRadius="14"
                                        HeightRequest="28"
                                        Padding="14,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </RefreshView>


        <!-- ===================================================== -->
        <!-- EMPTY STATE                                           -->
        <!-- ===================================================== -->

        <ContentView
            x:Name="DirectoryEmptyState"
            Grid.Row="2"
            ZIndex="2"
            IsVisible="False"
            Padding="32,24"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True">

            <VerticalStackLayout
                Spacing="8"
                HorizontalOptions="Fill"
                VerticalOptions="Center">


                <!-- EMPTY IMAGE -->

                <Image
                    x:Name="EmptyStateImage"
                    Source="noregisterrequest.png"
                    IsVisible="False"
                    WidthRequest="132"
                    HeightRequest="132"
                    Aspect="AspectFit"
                    Margin="0,0,0,4"
                    HorizontalOptions="Center"/>


                <!-- EMPTY TITLE -->

                <Label
                    x:Name="EmptyStateTitleLabel"
                    Text="No accounts found"
                    Style="{StaticResource EmptyStateTitle}"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"/>


                <!-- EMPTY MESSAGE -->

                <Label
                    x:Name="EmptyStateMessageLabel"
                    Text="No active teacher or staff accounts yet."
                    Style="{StaticResource EmptyStateMessage}"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </ContentView>


        <!-- ===================================================== -->
        <!-- SCOPE DROPDOWN                                        -->
        <!-- ===================================================== -->

        <Border
            x:Name="ScopeDropdownPanel"
            Grid.RowSpan="3"
            ZIndex="30"
            WidthRequest="180"
            HorizontalOptions="Start"
            Margin="18,0,0,0"
            Style="{StaticResource DropdownPanel}">

            <VerticalStackLayout
                x:Name="ScopeOptionsHost"
                Spacing="2"/>

        </Border>


        <!-- ===================================================== -->
        <!-- ROW ACTION MENU                                       -->
        <!-- ===================================================== -->

        <Border
            x:Name="RowActionPanel"
            Grid.RowSpan="3"
            ZIndex="40"
            IsVisible="False"
            Opacity="0"
            WidthRequest="180"
            HorizontalOptions="End"
            Margin="0,0,18,0"
            Style="{StaticResource DropdownPanel}">

            <VerticalStackLayout
                x:Name="RowActionOptionsHost"
                Spacing="2"/>

        </Border>


        <!-- ===================================================== -->
        <!-- BOTTOM NAVIGATION                                     -->
        <!-- ===================================================== -->

        <local:BottomNavigationBar
            Grid.Row="3"
            ActiveTab="None"/>


        <!-- ===================================================== -->
        <!-- PAGE MENU OVERLAY                                     -->
        <!-- ===================================================== -->

        <Grid
            x:Name="PageMenuOverlay"
            Grid.RowSpan="4"
            ZIndex="100"
            IsVisible="False"
            InputTransparent="False">


            <!-- BACKDROP -->

            <BoxView
                x:Name="PageMenuBackdrop"
                Color="{StaticResource ScrimLight}">

                <BoxView.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="OnPageMenuBackdropTapped"/>

                </BoxView.GestureRecognizers>

            </BoxView>


            <!-- ================================================= -->
            <!-- BOTTOM SHEET                                      -->
            <!-- ================================================= -->

            <Border
                x:Name="PageMenuSheet"
                Padding="0,10,0,18"
                BackgroundColor="{StaticResource SurfaceBase}"
                Stroke="Transparent"
                StrokeThickness="0"
                VerticalOptions="End">

                <Border.StrokeShape>

                    <RoundRectangle CornerRadius="24,24,0,0"/>

                </Border.StrokeShape>


                <Border.Shadow>

                    <Shadow
                        Brush="{StaticResource ShadowOverlay}"
                        Offset="0,-4"
                        Radius="16"
                        Opacity="0.55"/>

                </Border.Shadow>


                <VerticalStackLayout Spacing="0">


                    <!-- DRAG INDICATOR -->

                    <BoxView
                        WidthRequest="42"
                        HeightRequest="4"
                        CornerRadius="2"
                        Color="{StaticResource Slate200}"
                        HorizontalOptions="Center"
                        Margin="0,0,0,8"/>


                    <!-- ================================================= -->
                    <!-- ACTIVE ACCOUNTS                                   -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="ActiveAccountsOption"
                        HeightRequest="46"
                        Padding="28,0"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        SemanticProperties.Description="Show active accounts">

                        <Grid>

                            <Label
                                x:Name="ActiveAccountsOptionTitle"
                                Text="Active Accounts"
                                FontSize="{StaticResource FontBody}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalTextAlignment="Center"/>

                        </Grid>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnActiveAccountsTapped"/>

                        </Border.GestureRecognizers>

                    </Border>


                    <!-- DIVIDER -->

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource BorderDefault}"
                        HorizontalOptions="Fill"/>


                    <!-- ================================================= -->
                    <!-- REGISTER REQUESTS                                 -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="RegisterRequestsOption"
                        HeightRequest="46"
                        Padding="28,0"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        SemanticProperties.Description="Show requests awaiting approval">

                        <Grid>

                            <Label
                                x:Name="RegisterRequestsOptionTitle"
                                Text="Request Approval"
                                FontSize="{StaticResource FontBody}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalTextAlignment="Center"/>

                        </Grid>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnRegisterRequestsTapped"/>

                        </Border.GestureRecognizers>

                    </Border>


                    <!-- DIVIDER -->

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource BorderDefault}"
                        HorizontalOptions="Fill"/>


                    <!-- ================================================= -->
                    <!-- DISABLED ACCOUNTS                                 -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="DisabledAccountsOption"
                        HeightRequest="46"
                        Padding="28,0"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        SemanticProperties.Description="Show disabled accounts">

                        <Grid>

                            <Label
                                x:Name="DisabledAccountsOptionTitle"
                                Text="Disabled Accounts"
                                FontSize="{StaticResource FontBody}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalTextAlignment="Center"/>

                        </Grid>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnDisabledAccountsTapped"/>

                        </Border.GestureRecognizers>

                    </Border>

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</base:EduTaskPage>
