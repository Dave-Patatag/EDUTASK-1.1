<?xml version="1.0" encoding="utf-8" ?>
<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base"
                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:local="clr-namespace:EDUTASK_1._1.Views"
                  xmlns:models="clr-namespace:EDUTASK_1._1.Models"
                  x:Class="EDUTASK_1._1.Views.TeachersPage"
                  NavigationPage.HasNavigationBar="False"
                  Shell.NavBarIsVisible="False"
                  BackgroundColor="{StaticResource SurfaceMuted}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: back, centred title, and the page menu behind the round
             button on the right. Same shape as the Tasks and Summary Report
             headers, so the section reads as part of one app. -->
        <Grid x:Name="PageHeader" Padding="18,14" ColumnDefinitions="44,*,44"
              BackgroundColor="{StaticResource SurfaceMuted}">

            <ImageButton x:Name="HeaderBackButton"
                         Source="backicon.png" Clicked="OnBack"
                         Pressed="OnHeaderBackPressed" Released="OnHeaderBackReleased"
                         WidthRequest="42" HeightRequest="42" Padding="10"
                         CornerRadius="12" BackgroundColor="{StaticResource SurfaceBase}"
                         BorderWidth="0"
                         HorizontalOptions="Start" VerticalOptions="Center"
                         SemanticProperties.Description="Go back"/>

            <Label x:Name="HeaderTitleLabel" Grid.Column="1" Text="Teachers &amp; Staff"
                   FontSize="{StaticResource FontHeading}" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level1"/>

            <ImageButton x:Name="MenuButton" Grid.Column="2"
                         Source="dotmenu.png" Clicked="OnPageMenuClicked"
                         Pressed="OnHeaderMenuPressed" Released="OnHeaderMenuReleased"
                         WidthRequest="42" HeightRequest="42" Padding="10"
                         CornerRadius="21" BackgroundColor="{StaticResource SurfaceBase}"
                         BorderWidth="0"
                         HorizontalOptions="End" VerticalOptions="Center"
                         SemanticProperties.Description="Directory menu"/>

        </Grid>

        <!-- Scope filter, then search. The filled pill is the current scope and
             opens the menu; search narrows whatever the scope let through. -->
        <Grid x:Name="FilterRow" Grid.Row="1"
              Padding="14,12,14,8" ColumnDefinitions="Auto,*" ColumnSpacing="8"
              BackgroundColor="{StaticResource SurfaceMuted}">

            <!-- Filled at rest rather than only while open: on this page the
                 pill is the one control in the row, and the design calls for it
                 to read as the current scope, not as an idle button. Only the
                 fill is set here — FilterPill's states change opacity alone, so
                 a colour set on the instance survives hover. -->
            <Border x:Name="ScopePill" Style="{StaticResource FilterPill}">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                    <Label x:Name="ScopePillLabel" Text="All"
                           Style="{StaticResource FilterPillLabel}"/>
                    <Label x:Name="ScopePillChevron" Grid.Column="1" Text="&#x25BC;"
                           Style="{StaticResource FilterPillChevron}"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScopeFilterTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="SearchBorder" Grid.Column="1"
                    HeightRequest="42" Padding="12,0"
                    BackgroundColor="{StaticResource SurfaceBase}"
                    Stroke="{StaticResource BorderStrong}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,18" ColumnSpacing="8">
                    <Entry x:Name="SearchEntry"
                           Style="{StaticResource SearchFieldEntry}"
                           Placeholder="Search by name"
                           VerticalTextAlignment="Center" VerticalOptions="Fill"
                           Margin="0"
                           TextChanged="OnSearchTextChanged"/>
                    <Image Grid.Column="1" Source="search.png"
                           WidthRequest="16" HeightRequest="16"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Roster. One card serves all three lists; DirectoryCardItem decides
             what the badge says and which action the row offers. -->
        <RefreshView x:Name="DirectoryRefresh" Grid.Row="2" Refreshing="OnRefresh"
                     BackgroundColor="{StaticResource SurfaceMuted}"
                     Padding="0,2,0,6">
            <Grid>
            <CollectionView x:Name="DirectoryView"
                            Margin="{StaticResource CardListMargin}"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepScrollOffset">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="3"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DirectoryCardItem">
                        <Border Style="{StaticResource ListCard}"
                                MinimumHeightRequest="62">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAccountCardTapped"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="1">

                                <Border Grid.RowSpan="2"
                                        WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="{StaticResource SurfaceSunken}"
                                        StrokeThickness="0" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Initials}"
                                           FontSize="{StaticResource FontBodySmall}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>

                                <Label Grid.Column="1" Text="{Binding FullName}"
                                       FontSize="{StaticResource FontSubheading}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"
                                       VerticalTextAlignment="End"/>

                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding UsernameDisplay}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextTertiary}"
                                       LineBreakMode="TailTruncation"/>

                                <Border Grid.Row="1" Grid.Column="2"
                                        IsVisible="{Binding ShowBadge}"
                                        Padding="0" StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="End" VerticalOptions="End">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding BadgeText}"
                                           FontSize="{StaticResource FontMicro}"
                                           FontAttributes="Bold"
                                           TextColor="{Binding BadgeColor}"/>
                                </Border>

                                <Button Grid.Row="1" Grid.Column="2" Text="Approve"
                                        IsVisible="{Binding ShowApprove}"
                                        Clicked="OnApprove" CommandParameter="{Binding .}"
                                        FontSize="{StaticResource FontLabel}"
                                        BackgroundColor="{StaticResource StatusSuccess}"
                                        TextColor="{StaticResource TextInverse}"
                                        CornerRadius="14" HeightRequest="28" Padding="14,0"
                                        HorizontalOptions="End" VerticalOptions="End"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            </Grid>
        </RefreshView>

        <!-- A sibling of RefreshView so the empty state receives the full
             height of the page's content row instead of its intrinsic height. -->
        <ContentView x:Name="DirectoryEmptyState"
                     Grid.Row="2" ZIndex="2"
                     IsVisible="False"
                     Padding="32,24"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"
                     InputTransparent="True">
            <VerticalStackLayout Spacing="8"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center">
                <Image x:Name="EmptyStateImage"
                       Source="noregisterrequest.png"
                       IsVisible="False"
                       WidthRequest="132" HeightRequest="132"
                       Aspect="AspectFit"
                       Margin="0,0,0,4"
                       HorizontalOptions="Center"/>
                <Label x:Name="EmptyStateTitleLabel" Text="No accounts found"
                       Style="{StaticResource EmptyStateTitle}"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="EmptyStateMessageLabel"
                       Text="No active teacher or staff accounts yet."
                       Style="{StaticResource EmptyStateMessage}"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </ContentView>

        <!-- Menus. Both hang over the list from the root grid, anchored to their
             trigger by the controller, so opening one never moves the roster. -->
        <Border x:Name="ScopeDropdownPanel" Grid.RowSpan="3" ZIndex="30"
                WidthRequest="180" HorizontalOptions="Start" Margin="18,0,0,0"
                Style="{StaticResource DropdownPanel}">
            <VerticalStackLayout x:Name="ScopeOptionsHost" Spacing="2"/>
        </Border>

        <!-- Anchored beneath the selected row's overflow button. Hidden here
             and not only by its controller: that menu is built on the first row
             tap, so until then nothing had hidden the panel and an empty white
             card sat in the header next to the page menu button. -->
        <Border x:Name="RowActionPanel" Grid.RowSpan="3" ZIndex="40"
                IsVisible="False" Opacity="0"
                WidthRequest="180" HorizontalOptions="End" Margin="0,0,18,0"
                Style="{StaticResource DropdownPanel}">
            <VerticalStackLayout x:Name="RowActionOptionsHost" Spacing="2"/>
        </Border>

        <local:BottomNavigationBar Grid.Row="3" ActiveTab="None"/>

        <!-- Director directory menu. It is a bottom sheet instead of a small
             anchored dropdown so all three destinations remain comfortably
             tappable on a phone and the current view is immediately clear. -->
        <Grid x:Name="PageMenuOverlay" Grid.RowSpan="4" ZIndex="100"
              IsVisible="False" InputTransparent="False">
            <BoxView x:Name="PageMenuBackdrop" Color="{StaticResource ScrimLight}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPageMenuBackdropTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="PageMenuSheet"
                    Padding="0,10,0,18"
                    BackgroundColor="{StaticResource SurfaceBase}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowOverlay}"
                            Offset="0,-4" Radius="16" Opacity="0.55"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <BoxView WidthRequest="42" HeightRequest="4" CornerRadius="2"
                             Color="{StaticResource Slate200}"
                             HorizontalOptions="Center" Margin="0,0,0,8"/>

                    <Border x:Name="ActiveAccountsOption"
                            HeightRequest="46" Padding="28,0"
                            BackgroundColor="Transparent" StrokeThickness="0"
                            SemanticProperties.Description="Show active accounts">
                        <Grid>
                            <Label x:Name="ActiveAccountsOptionTitle" Text="Active Accounts"
                                   FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalTextAlignment="Center"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActiveAccountsTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}"
                             HorizontalOptions="Fill"/>

                    <Border x:Name="RegisterRequestsOption"
                            HeightRequest="46" Padding="28,0"
                            BackgroundColor="Transparent" StrokeThickness="0"
                            SemanticProperties.Description="Show registration requests">
                        <Grid>
                            <Label x:Name="RegisterRequestsOptionTitle" Text="Register Requests"
                                   FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalTextAlignment="Center"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterRequestsTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}"
                             HorizontalOptions="Fill"/>

                    <Border x:Name="DisabledAccountsOption"
                            HeightRequest="46" Padding="28,0"
                            BackgroundColor="Transparent" StrokeThickness="0"
                            SemanticProperties.Description="Show disabled accounts">
                        <Grid>
                            <Label x:Name="DisabledAccountsOptionTitle" Text="Disabled Accounts"
                                   FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalTextAlignment="Center"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDisabledAccountsTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</base:EduTaskPage>
