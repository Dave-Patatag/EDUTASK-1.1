<?xml version="1.0" encoding="utf-8" ?>
<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EDUTASK_1._1.Views.ForgotPasswordPage"
             NavigationPage.HasNavigationBar="False" BackgroundColor="{StaticResource SurfaceBase}">
    <ScrollView VerticalScrollBarVisibility="Never"
                HorizontalScrollBarVisibility="Never">
        <Border BackgroundColor="{StaticResource SurfaceBase}" StrokeThickness="0" Padding="24,24,24,24">
            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="40,*,40">
                    <ImageButton Source="authback.png" Clicked="OnBackClicked"
                                 WidthRequest="34" HeightRequest="34" Padding="6"
                                 BackgroundColor="Transparent" HorizontalOptions="Start"/>
                    <Label x:Name="HeaderTitleLabel" Grid.Column="1" Text="Forgot Password"
                           FontSize="{StaticResource FontHeading}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>

                <!-- Step 1: identify account -->
                <Grid x:Name="IdentifyStep" Margin="0,4,0,0">
                    <VerticalStackLayout Spacing="4">
                        <VerticalStackLayout Spacing="2" Margin="0,0,0,8">
                            <Label Text="STEP 1 OF 3"
                                   FontSize="{StaticResource FontMicro}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="Tell us which account to recover."
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Label Text="Account" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                        <Border x:Name="IdentifierBorder" Style="{StaticResource AuthField}">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                                <Image Source="loginusername.png" Style="{StaticResource AuthFieldIcon}"/>
                                <Entry x:Name="IdentifierEntry" Grid.Column="1"
                                       Style="{StaticResource AuthFieldEntry}"
                                       Placeholder="Username or email"
                                       TextChanged="OnIdentifierChanged"/>
                            </Grid>
                        </Border>
                        <Label x:Name="IdentifierErrorLabel" Style="{StaticResource AuthFieldError}"/>

                        <Button Text="Continue" Clicked="OnFindAccount"
                                Margin="0,24,0,0" FontSize="{StaticResource FontBody}"
                                BackgroundColor="{StaticResource Brand800}" TextColor="{StaticResource TextInverse}"
                                CornerRadius="8" HeightRequest="50" HorizontalOptions="Fill"/>
                    </VerticalStackLayout>

                </Grid>

                <!-- Step 2: answer security questions -->
                <VerticalStackLayout x:Name="QuestionsStep" Spacing="4" IsVisible="False">
                    <VerticalStackLayout Spacing="2" Margin="0,0,0,8">
                        <Label Text="STEP 2 OF 3"
                               FontSize="{StaticResource FontMicro}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Label Text="Answer your security questions."
                               FontSize="{StaticResource FontCaption}"
                               TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                    <Label x:Name="Question1Label" FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" Margin="0,6,0,2"/>
                    <Border x:Name="Answer1Border" Style="{StaticResource AuthField}">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Image Source="loginsecurityquestion.png" Style="{StaticResource AuthFieldIcon}"/>
                            <Entry x:Name="Answer1Entry" Grid.Column="1"
                                   Style="{StaticResource AuthFieldEntry}"
                                   Placeholder="Type your answer"
                                   TextChanged="OnAnswer1Changed"/>
                        </Grid>
                    </Border>
                    <Label x:Name="Answer1ErrorLabel" Style="{StaticResource AuthFieldError}"/>

                    <Label x:Name="Question2Label" FontSize="{StaticResource FontBody}" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" Margin="0,6,0,2"/>
                    <Border x:Name="Answer2Border" Style="{StaticResource AuthField}">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                            <Image Source="loginsecurityquestion.png" Style="{StaticResource AuthFieldIcon}"/>
                            <Entry x:Name="Answer2Entry" Grid.Column="1"
                                   Style="{StaticResource AuthFieldEntry}"
                                   Placeholder="Type your answer"
                                   TextChanged="OnAnswer2Changed"/>
                        </Grid>
                    </Border>
                    <Label x:Name="Answer2ErrorLabel" Style="{StaticResource AuthFieldError}"/>

                    <Label x:Name="VerificationErrorLabel" Style="{StaticResource AuthFieldError}"/>

                    <Button Text="Verify answers" Clicked="OnVerifyAnswers"
                            Margin="0,14,0,0" FontSize="{StaticResource FontBody}"
                            BackgroundColor="{StaticResource Brand800}" TextColor="{StaticResource TextInverse}"
                            CornerRadius="8" HeightRequest="50" HorizontalOptions="Fill"/>
                </VerticalStackLayout>

                <!-- Step 3: set new password -->
                <VerticalStackLayout x:Name="PasswordStep" Spacing="4" IsVisible="False">
                    <VerticalStackLayout Spacing="2" Margin="0,0,0,8">
                        <Label Text="STEP 3 OF 3"
                               FontSize="{StaticResource FontMicro}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Label Text="Create a new password."
                               FontSize="{StaticResource FontCaption}"
                               TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                    <Label Text="New password" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                    <Border x:Name="NewPasswordBorder" Style="{StaticResource AuthField}">
                        <Grid ColumnDefinitions="24,*,32" ColumnSpacing="8">
                            <Image Source="loginpassword.png" Style="{StaticResource AuthFieldIcon}"/>
                            <Entry x:Name="NewPasswordEntry" Grid.Column="1"
                                   Style="{StaticResource AuthFieldEntry}"
                                   Placeholder="New password" IsPassword="True"
                                   TextChanged="OnNewPasswordChanged"/>
                            <ImageButton x:Name="NewPasswordToggleButton" Grid.Column="2"
                                         Style="{StaticResource AuthFieldTrailingButton}"
                                         Source="loginshowpassword.png" Clicked="OnToggleNewPassword"
                                         ToolTipProperties.Text="Show password"
                                         SemanticProperties.Description="Show password"/>
                        </Grid>
                    </Border>
                    <Label x:Name="NewPasswordErrorLabel" Style="{StaticResource AuthFieldError}"/>

                    <Label Text="Confirm password" Style="{StaticResource FieldLabel}" Margin="0,1,0,0"/>
                    <Border x:Name="ConfirmPasswordBorder" Style="{StaticResource AuthField}">
                        <Grid ColumnDefinitions="24,*,32" ColumnSpacing="8">
                            <Image Source="loginpassword.png" Style="{StaticResource AuthFieldIcon}"/>
                            <Entry x:Name="ConfirmPasswordEntry" Grid.Column="1"
                                   Style="{StaticResource AuthFieldEntry}"
                                   Placeholder="Confirm new password" IsPassword="True"
                                   TextChanged="OnConfirmPasswordChanged"/>
                            <ImageButton x:Name="ConfirmPasswordToggleButton" Grid.Column="2"
                                         Style="{StaticResource AuthFieldTrailingButton}"
                                         Source="loginshowpassword.png" Clicked="OnToggleConfirmPassword"
                                         ToolTipProperties.Text="Show password"
                                         SemanticProperties.Description="Show password"/>
                        </Grid>
                    </Border>
                    <Label x:Name="ConfirmPasswordErrorLabel" Style="{StaticResource AuthFieldError}"/>

                    <Button Text="Reset Password" Clicked="OnResetPassword"
                            Margin="0,14,0,0" FontSize="{StaticResource FontBody}"
                            BackgroundColor="{StaticResource Brand800}" TextColor="{StaticResource TextInverse}"
                            CornerRadius="8" HeightRequest="50" HorizontalOptions="Fill"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</base:EduTaskPage>
