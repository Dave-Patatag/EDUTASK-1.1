<?xml version="1.0" encoding="utf-8" ?>

<base:EduTaskPage
    xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EDUTASK_1._1.Views"
    x:Class="EDUTASK_1._1.Views.CalendarPage"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource SurfaceMuted}">


    <!-- ========================================================= -->
    <!-- PAGE RESOURCES                                            -->
    <!-- ========================================================= -->

    <base:EduTaskPage.Resources>


        <!-- ===================================================== -->
        <!-- CALENDAR TASK CARD                                    -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="CalendarTaskCardTemplate">


            <!-- ================================================= -->
            <!-- CARD                                              -->
            <!-- ================================================= -->

            <Border
                Style="{StaticResource TaskListCard}"
                SemanticProperties.Description="{Binding CardDescription}">

                <Grid ColumnDefinitions="4,*">


                    <!-- ================================================= -->
                    <!-- LEFT STATUS STRIPE                                -->
                    <!-- ================================================= -->

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="4"
                        Margin="0,6,0,6"
                        CornerRadius="2"
                        Color="{Binding StatusColor}">


                        <BoxView.Triggers>


                            <!-- COMPLETED -->

                            <DataTrigger
                                TargetType="BoxView"
                                Binding="{Binding Status}"
                                Value="Completed">

                                <Setter
                                    Property="Color"
                                    Value="{StaticResource StatusSuccess}"/>

                            </DataTrigger>


                            <!-- OVERDUE -->

                            <DataTrigger
                                TargetType="BoxView"
                                Binding="{Binding Status}"
                                Value="Overdue">

                                <Setter
                                    Property="Color"
                                    Value="{StaticResource StatusDanger}"/>

                            </DataTrigger>


                            <!-- PENDING -->

                            <DataTrigger
                                TargetType="BoxView"
                                Binding="{Binding Status}"
                                Value="Pending">

                                <Setter
                                    Property="Color"
                                    Value="{StaticResource StatusPending}"/>

                            </DataTrigger>


                        </BoxView.Triggers>

                    </BoxView>


                    <!-- ================================================= -->
                    <!-- CARD CONTENT                                      -->
                    <!-- ================================================= -->

                    <Grid
                        Grid.Column="1"
                        Padding="12,9"
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8"
                        RowSpacing="3"
                        VerticalOptions="Center">


                        <!-- ================================================= -->
                        <!-- TASK TITLE                                        -->
                        <!-- ================================================= -->

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{Binding Title}"
                            FontSize="{StaticResource FontLabel}"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation"
                            VerticalTextAlignment="Center"
                            VerticalOptions="Center"/>


                        <!-- ================================================= -->
                        <!-- STATUS TEXT                                       -->
                        <!-- ================================================= -->

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding Status}"
                            FontSize="{StaticResource FontMicro}"
                            FontAttributes="Bold"
                            TextColor="{Binding StatusColor}"
                            HorizontalTextAlignment="End"
                            VerticalTextAlignment="Center"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            TranslationY="6">


                            <Label.Triggers>


                                <!-- PENDING -->

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Status}"
                                    Value="Pending">

                                    <Setter
                                        Property="TextColor"
                                        Value="{StaticResource StatusPending}"/>

                                </DataTrigger>


                                <!-- COMPLETED -->

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Status}"
                                    Value="Completed">

                                    <Setter
                                        Property="TextColor"
                                        Value="{StaticResource StatusSuccess}"/>

                                </DataTrigger>


                                <!-- OVERDUE -->

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Status}"
                                    Value="Overdue">

                                    <Setter
                                        Property="TextColor"
                                        Value="{StaticResource StatusDanger}"/>

                                </DataTrigger>


                            </Label.Triggers>

                        </Label>


                        <!-- ================================================= -->
                        <!-- ASSIGNED TO                                       -->
                        <!-- ================================================= -->

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="{Binding OwnerDisplay, StringFormat='Assigned to {0}'}"
                            IsVisible="{Binding HasOwnerDisplay}"
                            FontSize="{StaticResource FontMicro}"
                            TextColor="{StaticResource TextSecondary}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation"
                            VerticalTextAlignment="Center"/>

                    </Grid>

                </Grid>


                <!-- ================================================= -->
                <!-- TASK TAP                                         -->
                <!-- ================================================= -->

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="OnTaskTapped"
                        CommandParameter="{Binding Task_id}"/>

                </Border.GestureRecognizers>

            </Border>

        </DataTemplate>

    </base:EduTaskPage.Resources>


    <!-- ========================================================= -->
    <!-- PAGE ROOT                                                  -->
    <!-- ========================================================= -->

    <Grid
        RowDefinitions="Auto,*,Auto"
        RowSpacing="0">

        <Grid Grid.Row="0"
              Padding="15,13"
              ColumnDefinitions="42,*,42"
              BackgroundColor="{StaticResource SurfaceMuted}">

            <local:FlyoutMenuButton/>

            <Label Grid.Column="1"
                   Text="Calendar"
                   FontSize="{StaticResource FontHeading}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level1"/>

            <BoxView Grid.Column="2"
                     WidthRequest="38"
                     HeightRequest="38"
                     Color="Transparent"/>
        </Grid>


        <!-- ===================================================== -->
        <!-- CALENDAR + TASK CONTENT                               -->
        <!-- ===================================================== -->

        <Grid
            x:Name="ContentColumn"
            Grid.Row="1"
            RowDefinitions="Auto,*"
            RowSpacing="16"
            Padding="18,8,18,0">


            <!-- ================================================= -->
            <!-- CALENDAR                                          -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="12">


                <!-- ================================================= -->
                <!-- MONTH HEADER                                      -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="44,*,44"
                    ColumnSpacing="6">


                    <!-- PREVIOUS MONTH -->

                    <ImageButton
                        Source="calendarleft.png"
                        Clicked="OnPreviousMonthClicked"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="12"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Aspect="AspectFit"
                        SemanticProperties.Description="Previous month"/>


                    <!-- MONTH / YEAR -->

                    <Label
                        x:Name="MonthLabel"
                        Grid.Column="1"
                        FontSize="{StaticResource FontTitle}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Choose calendar month and year">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnMonthYearTapped"/>

                        </Label.GestureRecognizers>

                    </Label>


                    <!-- NEXT MONTH -->

                    <ImageButton
                        Grid.Column="2"
                        Source="calendarright.png"
                        Clicked="OnNextMonthClicked"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="12"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Aspect="AspectFit"
                        SemanticProperties.Description="Next month"/>

                </Grid>


                <!-- ================================================= -->
                <!-- DAYS OF WEEK                                      -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="*,*,*,*,*,*,*"
                    ColumnSpacing="2">

                    <Grid.Resources>

                        <Style TargetType="Label">

                            <Setter
                                Property="FontSize"
                                Value="{StaticResource FontLabel}"/>

                            <Setter
                                Property="FontAttributes"
                                Value="Bold"/>

                            <Setter
                                Property="CharacterSpacing"
                                Value="0.6"/>

                            <Setter
                                Property="TextColor"
                                Value="{StaticResource TextTertiary}"/>

                            <Setter
                                Property="HorizontalTextAlignment"
                                Value="Center"/>

                        </Style>

                    </Grid.Resources>


                    <Label
                        Grid.Column="0"
                        Text="MON"/>

                    <Label
                        Grid.Column="1"
                        Text="TUE"/>

                    <Label
                        Grid.Column="2"
                        Text="WED"/>

                    <Label
                        Grid.Column="3"
                        Text="THU"/>

                    <Label
                        Grid.Column="4"
                        Text="FRI"/>

                    <Label
                        Grid.Column="5"
                        Text="SAT"/>

                    <Label
                        Grid.Column="6"
                        Text="SUN"/>

                </Grid>


                <!-- ================================================= -->
                <!-- CALENDAR DAYS                                     -->
                <!-- ================================================= -->

                <Grid
                    x:Name="CalendarGrid"
                    ColumnDefinitions="*,*,*,*,*,*,*"
                    RowSpacing="2"
                    ColumnSpacing="2"/>


                <!-- DIVIDER -->

                <BoxView
                    HeightRequest="1"
                    Color="{StaticResource BorderDefault}"
                    Margin="0,6,0,0"/>

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- SELECTED DATE PANEL                               -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                RowDefinitions="Auto,*"
                RowSpacing="12">


                <!-- ================================================= -->
                <!-- SELECTED DATE HEADER                              -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">


                    <!-- DATE -->

                    <Label
                        x:Name="SelectedDateLabel"
                        FontSize="{StaticResource FontHeading}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalTextAlignment="Center"
                        LineBreakMode="TailTruncation"/>


                    <!-- ================================================= -->
                    <!-- TASK COUNT                                        -->
                    <!-- MATCHES ALL TEACHER BUTTON                        -->
                    <!-- ================================================= -->

                    <Border
                        Grid.Column="1"
                        Padding="10,4"
                        BackgroundColor="#111C3A"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        HorizontalOptions="End">

                        <Border.StrokeShape>

                            <RoundRectangle CornerRadius="10"/>

                        </Border.StrokeShape>


                        <Label
                            x:Name="TaskCountLabel"
                            FontSize="{StaticResource FontLabel}"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- TASK LIST AREA                                    -->
                <!-- ================================================= -->

                <Grid Grid.Row="1">


                    <!-- ================================================= -->
                    <!-- TASK LIST                                         -->
                    <!-- ================================================= -->

                    <ScrollView
                        x:Name="TaskScroller"
                        VerticalScrollBarVisibility="Never">

                        <VerticalStackLayout
                            x:Name="TaskList"
                            Spacing="3"
                            Padding="0,0,0,20">

                            <BindableLayout.ItemTemplate>

                                <StaticResource
                                    Key="CalendarTaskCardTemplate"/>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </ScrollView>


                    <!-- ================================================= -->
                    <!-- LOADING                                           -->
                    <!-- ================================================= -->

                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="{StaticResource Brand800}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>


                    <!-- ================================================= -->
                    <!-- EMPTY STATE                                       -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        x:Name="EmptyState"
                        IsVisible="False"
                        Spacing="6"
                        Padding="20,4"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        Margin="0,0,0,20">


                        <Image
                            Source="notaskdue.png"
                            WidthRequest="132"
                            HeightRequest="110"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            InputTransparent="True"/>


                        <Label
                            Text="Pick another date to see its deadlines."
                            Style="{StaticResource EmptyStateMessage}"
                            FontSize="{StaticResource FontBody}"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </Grid>

            </Grid>

        </Grid>


        <!-- ===================================================== -->
        <!-- BOTTOM NAVIGATION                                     -->
        <!-- ===================================================== -->

        <local:BottomNavigationBar
            Grid.Row="2"
            ActiveTab="None"/>

    </Grid>

</base:EduTaskPage>
