<?xml version="1.0" encoding="utf-8" ?>

<base:EduTaskPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base"
    xmlns:local="clr-namespace:EDUTASK_1._1.Views"
    x:Class="EDUTASK_1._1.Views.DirectorStaffDashboardPage"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource SurfaceBase}">

    <ContentPage.Resources>

        <!-- ===================================================== -->
        <!-- EXPANDED TASK                                         -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="AdminTaskCardTemplate">

            <VerticalStackLayout
                Margin="0,3,10,9"
                Spacing="0">

                <!-- ================================================= -->
                <!-- TASK TITLE / PRIORITY / STATUS                    -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="6">

                    <Label
                        Text="{Binding Title}"
                        FontSize="{StaticResource FontMicro}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        LineBreakMode="TailTruncation"
                        VerticalOptions="Center"/>


                    <!-- PRIORITY BADGE -->

                    <Border
                        Grid.Column="1"
                        HeightRequest="20"
                        MinimumWidthRequest="50"
                        Padding="8,1"
                        BackgroundColor="Transparent"
                        Stroke="{Binding PriorityColor}"
                        StrokeThickness="1"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7"/>
                        </Border.StrokeShape>

                        <Border.Triggers>

                            <!-- HIGH -->

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding Priority}"
                                Value="High">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="#F3E8FF"/>

                                <Setter
                                    Property="Stroke"
                                    Value="#7C3AED"/>

                            </DataTrigger>


                            <!-- MEDIUM -->

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding Priority}"
                                Value="Medium">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="#FFF7E8"/>

                                <Setter
                                    Property="Stroke"
                                    Value="#D97706"/>

                            </DataTrigger>


                            <!-- LOW -->

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding Priority}"
                                Value="Low">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="#ECFDF5"/>

                                <Setter
                                    Property="Stroke"
                                    Value="#059669"/>

                            </DataTrigger>

                        </Border.Triggers>


                        <Label
                            Text="{Binding Priority}"
                            FontSize="9"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{Binding PriorityColor}">

                            <Label.Triggers>

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Priority}"
                                    Value="High">

                                    <Setter
                                        Property="TextColor"
                                        Value="#7C3AED"/>

                                </DataTrigger>


                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Priority}"
                                    Value="Medium">

                                    <Setter
                                        Property="TextColor"
                                        Value="#B45309"/>

                                </DataTrigger>


                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Priority}"
                                    Value="Low">

                                    <Setter
                                        Property="TextColor"
                                        Value="#047857"/>

                                </DataTrigger>

                            </Label.Triggers>

                        </Label>

                    </Border>


                    <!-- STATUS BADGE -->

                    <Border
                        Grid.Column="2"
                        HeightRequest="20"
                        MinimumWidthRequest="52"
                        Padding="7,1"
                        BackgroundColor="Transparent"
                        Stroke="{Binding StatusColor}"
                        StrokeThickness="1"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7"/>
                        </Border.StrokeShape>

                        <Border.Triggers>

                            <!-- PENDING -->

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding Status}"
                                Value="Pending">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="#FFE3D0"/>

                                <Setter
                                    Property="Stroke"
                                    Value="#FF9A5A"/>

                            </DataTrigger>


                            <!-- ACKNOWLEDGED -->

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding Status}"
                                Value="Acknowledged">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="#D6E8FF"/>

                                <Setter
                                    Property="Stroke"
                                    Value="#4A90FF"/>

                            </DataTrigger>

                        </Border.Triggers>


                        <Label
                            Text="{Binding Status}"
                            FontSize="9"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{Binding StatusColor}">

                            <Label.Triggers>

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Status}"
                                    Value="Pending">

                                    <Setter
                                        Property="TextColor"
                                        Value="#F07818"/>

                                </DataTrigger>


                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding Status}"
                                    Value="Acknowledged">

                                    <Setter
                                        Property="TextColor"
                                        Value="#2D74D8"/>

                                </DataTrigger>

                            </Label.Triggers>

                        </Label>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- DESCRIPTION                                       -->
                <!-- ================================================= -->

                <Label
                    Text="{Binding Description}"
                    FontSize="{StaticResource FontMicro}"
                    TextColor="{StaticResource TextTertiary}"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Margin="0,7,0,6"/>


                <!-- DIVIDER -->

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="#9CA3AF"
                    Margin="0,0,0,6"/>


                <!-- ================================================= -->
                <!-- SUBTASKS                                          -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    IsVisible="{Binding HasSubtasks}"
                    Spacing="5">

                    <Label
                        Text="Subtasks"
                        FontSize="{StaticResource FontMicro}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        Margin="0,0,0,1"/>


                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Subtasks}"
                        Spacing="5">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    HeightRequest="38"
                                    Padding="7,3"
                                    BackgroundColor="{StaticResource SurfaceBase}"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="7"/>
                                    </Border.StrokeShape>

                                    <Border.Shadow>

                                        <Shadow
                                            Brush="Black"
                                            Offset="0,1"
                                            Radius="3"
                                            Opacity="0.08"/>

                                    </Border.Shadow>


                                    <Grid
                                        ColumnDefinitions="22,*,Auto"
                                        ColumnSpacing="6">


                                        <!-- EMPTY SUBTASK SQUARE -->

                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="15"
                                            HeightRequest="15"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            Stroke="{Binding MarkerColor}"
                                            StrokeThickness="1"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4"/>
                                            </Border.StrokeShape>

                                        </Border>


                                        <!-- SUBTASK TITLE -->

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="0"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="9"
                                                TextColor="{Binding TitleColor}"
                                                TextDecorations="{Binding TitleDecoration}"
                                                LineBreakMode="TailTruncation"
                                                VerticalOptions="Center"/>

                                            <Label
                                                Text="{Binding ProofStatusText}"
                                                IsVisible="{Binding ShowProofToReviewer}"
                                                FontSize="7"
                                                TextColor="{Binding ProofStatusColor}"
                                                LineBreakMode="TailTruncation"/>

                                        </VerticalStackLayout>


                                        <!-- SUBTASK ACTIONS -->

                                        <HorizontalStackLayout
                                            Grid.Column="2"
                                            Spacing="3"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">


                                            <!-- COMMENT -->

                                            <Grid
                                                WidthRequest="28"
                                                HeightRequest="28">

                                                <ImageButton
                                                    Source="comment.png"
                                                    Aspect="AspectFit"
                                                    Padding="3"
                                                    WidthRequest="26"
                                                    HeightRequest="26"
                                                    CornerRadius="13"
                                                    BackgroundColor="Transparent"
                                                    ToolTipProperties.Text="Discussion"
                                                    SemanticProperties.Description="Open subtask discussion"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnSubtaskDiscussionClicked"/>


                                                <!-- UNREAD BADGE -->

                                                <Border
                                                    IsVisible="{Binding HasUnreadDiscussion}"
                                                    BackgroundColor="{StaticResource StatusDanger}"
                                                    StrokeThickness="0"
                                                    Padding="2,0"
                                                    MinimumWidthRequest="12"
                                                    HeightRequest="12"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    InputTransparent="True">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6"/>
                                                    </Border.StrokeShape>

                                                    <Label
                                                        Text="{Binding UnreadDiscussionDisplay}"
                                                        FontSize="6"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource TextInverse}"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"/>

                                                </Border>

                                            </Grid>


                                            <!-- PROOF HISTORY -->

                                            <ImageButton
                                                Source="viewproof.png"
                                                Aspect="AspectFit"
                                                Padding="5"
                                                WidthRequest="27"
                                                HeightRequest="27"
                                                CornerRadius="14"
                                                BackgroundColor="Transparent"
                                                IsVisible="{Binding HasProofHistory}"
                                                ToolTipProperties.Text="{Binding ProofHistoryButtonText}"
                                                SemanticProperties.Description="{Binding ProofHistoryButtonText}"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnProofHistoryButtonClicked"/>

                                        </HorizontalStackLayout>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- PROGRESS - THICK + CENTERED                       -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="7"
                    Margin="0,8,0,0"
                    HeightRequest="22"
                    VerticalOptions="Center">

                    <Label
                        Grid.Column="0"
                        Text="Progress"
                        FontSize="9"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"/>

                    <ProgressBar
                        Grid.Column="1"
                        Progress="{Binding ProgressValue}"
                        HeightRequest="7"
                        ScaleY="1.7"
                        TranslationY="0"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        ProgressColor="{StaticResource Accent500}"
                        BackgroundColor="#CFCFCF"/>

                    <Label
                        Grid.Column="2"
                        Text="{Binding ProgressPercentText}"
                        FontSize="9"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"/>

                </Grid>


                <!-- ================================================= -->
                <!-- TASK ACTIONS                                      -->
                <!-- ================================================= -->

                <HorizontalStackLayout
                    HorizontalOptions="End"
                    Spacing="6"
                    Margin="0,5,0,0">


                    <!-- EDIT TASK -->

                    <Border
                        HeightRequest="29"
                        Padding="11,0"
                        BackgroundColor="{StaticResource Brand800}"
                        StrokeThickness="0"
                        IsVisible="{Binding CanEdit}"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Label
                            Text="Edit Task"
                            FontSize="9"
                            TextColor="{StaticResource TextInverse}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnAdminEditTapped"
                                CommandParameter="{Binding .}"/>

                        </Border.GestureRecognizers>

                    </Border>


                    <!-- COMPLETE TASK -->

                    <Button
                        Text="Complete Task"
                        FontSize="9"
                        Padding="11,3"
                        HeightRequest="29"
                        MinimumHeightRequest="29"
                        CornerRadius="6"
                        VerticalOptions="Center"
                        IsVisible="{Binding CanValidate}"
                        BackgroundColor="{StaticResource StatusSuccess}"
                        TextColor="{StaticResource TextInverse}"
                        CommandParameter="{Binding AssignmentID}"
                        Clicked="OnValidateClicked"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </DataTemplate>


        <!-- ===================================================== -->
        <!-- OUTER TASK CARD                                       -->
        <!-- ===================================================== -->

        <DataTemplate x:Key="AdminDeadlineGroupTemplate">

            <Border
                Margin="12,5"
                Padding="0"
                BackgroundColor="{StaticResource SurfaceBase}"
                Stroke="#E5E7EB"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9"/>
                </Border.StrokeShape>

                <Border.Shadow>

                    <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="5"
                        Opacity="0.09"/>

                </Border.Shadow>


                <Grid ColumnDefinitions="5,*">


                    <!-- PRIORITY STRIPE -->

                    <BoxView
                        Grid.Column="0"
                        Color="{Binding PriorityColor}"
                        Margin="0,9,0,9"
                        CornerRadius="3"
                        VerticalOptions="Fill"/>


                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="0"
                        Padding="9,7,9,7">


                        <!-- ================================================= -->
                        <!-- DATE / ASSIGNEE                                    -->
                        <!-- ================================================= -->

                        <Grid
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="5">


                            <VerticalStackLayout
                                Spacing="2"
                                VerticalOptions="Center">


                                <!-- DATE -->

                                <Grid
                                    ColumnDefinitions="17,*"
                                    ColumnSpacing="7"
                                    VerticalOptions="Center">

                                    <Image
                                        Grid.Column="0"
                                        Source="date.png"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Aspect="AspectFit"
                                        Opacity="1"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding DeadlineDisplay}"
                                        FontSize="{StaticResource FontBodySmall}"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="TailTruncation"
                                        VerticalOptions="Center"/>

                                </Grid>


                                <!-- ASSIGNED TO -->

                                <Grid
                                    ColumnDefinitions="18,*"
                                    ColumnSpacing="7"
                                    VerticalOptions="Center">

                                    <Image
                                        Grid.Column="0"
                                        Source="profileuser.png"
                                        WidthRequest="12"
                                        HeightRequest="12"
                                        Aspect="AspectFit"
                                        Opacity="1"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                    <Label
                                        Grid.Column="1"
                                        FontSize="{StaticResource FontMicro}"
                                        TextColor="{StaticResource TextPrimary}"
                                        VerticalOptions="Center">

                                        <Label.FormattedText>

                                            <FormattedString>

                                                <Span Text="Assigned to: "/>

                                                <Span Text="{Binding TeacherSummary}"/>

                                            </FormattedString>

                                        </Label.FormattedText>

                                    </Label>

                                </Grid>

                            </VerticalStackLayout>


                            <!-- UNREAD DISCUSSION -->

                            <Border
                                Grid.Column="1"
                                IsVisible="{Binding ShowUnreadDiscussion}"
                                BackgroundColor="{StaticResource StatusDanger}"
                                StrokeThickness="0"
                                Padding="4,0"
                                MinimumWidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="End"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9"/>
                                </Border.StrokeShape>

                                <Label
                                    Text="{Binding UnreadDiscussionDisplay}"
                                    FontSize="{StaticResource FontMicro}"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextInverse}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"/>

                            </Border>


                            <!-- EXPAND / COLLAPSE -->

                            <Label
                                Grid.Column="2"
                                Text="{Binding Arrow}"
                                Rotation="{Binding ArrowRotation}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                WidthRequest="22"
                                HeightRequest="22"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                VerticalOptions="Start"/>


                            <Grid.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnDeadlineGroupTapped"
                                    CommandParameter="{Binding .}"/>

                            </Grid.GestureRecognizers>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- COLLAPSED TASK                                    -->
                        <!-- ================================================= -->

                        <VerticalStackLayout
                            IsVisible="{Binding IsCollapsed}"
                            BindableLayout.ItemsSource="{Binding Tasks}"
                            Spacing="2"
                            Margin="0,7,0,0">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        RowDefinitions="Auto,Auto"
                                        ColumnDefinitions="*,Auto"
                                        RowSpacing="3">


                                        <!-- TASK TITLE -->

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            FontSize="{StaticResource FontMicro}"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}"
                                            LineBreakMode="TailTruncation"
                                            VerticalOptions="Center"/>


                                        <!-- STATUS -->

                                        <Border
                                            Grid.Column="1"
                                            HeightRequest="20"
                                            MinimumWidthRequest="52"
                                            Padding="7,1"
                                            BackgroundColor="Transparent"
                                            Stroke="{Binding StatusColor}"
                                            StrokeThickness="1"
                                            VerticalOptions="Center">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="7"/>
                                            </Border.StrokeShape>

                                            <Border.Triggers>

                                                <!-- PENDING -->

                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding Status}"
                                                    Value="Pending">

                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="#FFE3D0"/>

                                                    <Setter
                                                        Property="Stroke"
                                                        Value="#FF9A5A"/>

                                                </DataTrigger>


                                                <!-- ACKNOWLEDGED -->

                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding Status}"
                                                    Value="Acknowledged">

                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="#D6E8FF"/>

                                                    <Setter
                                                        Property="Stroke"
                                                        Value="#4A90FF"/>

                                                </DataTrigger>

                                            </Border.Triggers>


                                            <Label
                                                Text="{Binding Status}"
                                                FontSize="9"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                TextColor="{Binding StatusColor}">

                                                <Label.Triggers>

                                                    <!-- PENDING -->

                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding Status}"
                                                        Value="Pending">

                                                        <Setter
                                                            Property="TextColor"
                                                            Value="#F07818"/>

                                                    </DataTrigger>


                                                    <!-- ACKNOWLEDGED -->

                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding Status}"
                                                        Value="Acknowledged">

                                                        <Setter
                                                            Property="TextColor"
                                                            Value="#2D74D8"/>

                                                    </DataTrigger>

                                                </Label.Triggers>

                                            </Label>

                                        </Border>


                                        <!-- ================================================= -->
                                        <!-- COLLAPSED PROGRESS - THICK + CENTERED             -->
                                        <!-- ================================================= -->

                                        <Grid
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="7"
                                            Margin="0,3,0,1"
                                            HeightRequest="20"
                                            VerticalOptions="Center">

                                            <Label
                                                Grid.Column="0"
                                                Text="Progress"
                                                FontSize="8"
                                                TextColor="{StaticResource TextSecondary}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center"/>

                                            <ProgressBar
                                                Grid.Column="1"
                                                Progress="{Binding ProgressValue}"
                                                HeightRequest="7"
                                                ScaleY="1.7"
                                                TranslationY="0"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Fill"
                                                ProgressColor="{StaticResource Accent500}"
                                                BackgroundColor="#CFCFCF"/>

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding ProgressPercentText}"
                                                FontSize="8"
                                                TextColor="{StaticResource TextPrimary}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center"/>

                                        </Grid>

                                    </Grid>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>


                        <!-- ================================================= -->
                        <!-- EXPANDED TASK                                     -->
                        <!-- ================================================= -->

                        <VerticalStackLayout
                            IsVisible="{Binding IsExpanded}"
                            BindableLayout.ItemsSource="{Binding Tasks}"
                            BindableLayout.ItemTemplate="{StaticResource AdminTaskCardTemplate}"
                            Spacing="0"/>

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </DataTemplate>

    </ContentPage.Resources>


    <!-- ========================================================= -->
    <!-- MAIN PAGE                                                  -->
    <!-- ========================================================= -->

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="0"
        BackgroundColor="{StaticResource SurfaceBase}">


        <!-- ===================================================== -->
        <!-- HEADER + SEARCH                                       -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="0"
            RowDefinitions="Auto,Auto"
            RowSpacing="9"
            Padding="15,13,15,8">


            <!-- HEADER -->

            <Grid
                ColumnDefinitions="42,*"
                ColumnSpacing="11">


                <!-- MENU -->

                <Border
                    WidthRequest="38"
                    HeightRequest="38"
                    BackgroundColor="{StaticResource SurfaceBase}"
                    Stroke="{StaticResource BorderSubtle}"
                    StrokeThickness="1"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Open navigation menu">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>

                    <Border.Shadow>

                        <Shadow
                            Brush="Black"
                            Offset="0,1"
                            Radius="3"
                            Opacity="0.07"/>

                    </Border.Shadow>

                    <Image
                        Source="menubar.png"
                        WidthRequest="19"
                        HeightRequest="19"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="OnMenuBarClicked"/>

                    </Border.GestureRecognizers>

                </Border>


                <!-- USER -->

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="0"
                    VerticalOptions="Center">

                    <Label
                        x:Name="GreetingLabel"
                        Text="Good morning"
                        FontSize="{StaticResource FontMicro}"
                        TextColor="{StaticResource TextPrimary}"/>

                    <Label
                        x:Name="DashboardUserNameLabel"
                        Text="Tasks"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        LineBreakMode="TailTruncation"/>

                </VerticalStackLayout>

            </Grid>


            <!-- ================================================= -->
            <!-- SEARCH BAR - CORNER RADIUS 10                     -->
            <!-- ================================================= -->

            <Border
                Grid.Row="1"
                HeightRequest="36"
                BackgroundColor="#FFFFFF"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                Padding="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>


                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    Padding="12,0,12,0">


                    <!-- SEARCH ENTRY -->

                    <Entry
                        x:Name="TaskSearchBar"
                        Placeholder="Search tasks"
                        Style="{StaticResource SearchFieldEntry}"
                        TextChanged="OnSearchTextChanged"
                        FontSize="{StaticResource FontMicro}"
                        TextColor="{StaticResource TextPrimary}"
                        PlaceholderColor="#98A2B3"
                        BackgroundColor="Transparent"
                        VerticalOptions="Fill"
                        VerticalTextAlignment="Center"/>


                    <!-- CLEAR SEARCH -->

                    <Label
                        x:Name="ClearSearchButton"
                        Grid.Column="1"
                        Text="&#x2715;"
                        FontSize="{StaticResource FontBody}"
                        TextColor="{StaticResource TextDisabled}"
                        IsVisible="False"
                        VerticalOptions="Center"
                        Padding="5,0">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnClearSearchTapped"/>

                        </Label.GestureRecognizers>

                    </Label>


                    <!-- SEARCH ICON -->

                    <Image
                        Grid.Column="2"
                        Source="search.png"
                        WidthRequest="18"
                        HeightRequest="18"
                        Aspect="AspectFit"
                        Margin="4,0,0,0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Image.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnSearchIconTapped"/>

                        </Image.GestureRecognizers>

                    </Image>

                </Grid>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- FILTER BUTTONS                                        -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="Auto,Auto,Auto,*,Auto"
            ColumnSpacing="8"
            Padding="15,2,15,6">


            <!-- ALL -->

            <Border
                x:Name="AllFilterBorder"
                Grid.Column="0"
                Style="{StaticResource FilterChip}"
                HeightRequest="29"
                MinimumWidthRequest="38"
                Padding="10,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7"/>
                </Border.StrokeShape>

                <Label
                    x:Name="AllFilterLabel"
                    Text="All"
                    Style="{StaticResource FilterChipLabel}"
                    FontSize="{StaticResource FontMicro}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="OnAllTasksClicked"/>

                </Border.GestureRecognizers>

            </Border>


            <!-- TODAY -->

            <Border
                x:Name="TodayFilterBorder"
                Grid.Column="1"
                Style="{StaticResource FilterChip}"
                HeightRequest="29"
                MinimumWidthRequest="73"
                Padding="13,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7"/>
                </Border.StrokeShape>

                <Border.Shadow>

                    <Shadow
                        Brush="Black"
                        Offset="0,1"
                        Radius="3"
                        Opacity="0.07"/>

                </Border.Shadow>

                <Label
                    x:Name="TodayFilterLabel"
                    Text="Today"
                    Style="{StaticResource FilterChipLabel}"
                    FontSize="{StaticResource FontMicro}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="OnTodayTasksClicked"/>

                </Border.GestureRecognizers>

            </Border>


            <!-- OVERDUE -->

            <Border
                x:Name="OverdueFilterBorder"
                Grid.Column="2"
                Style="{StaticResource FilterChip}"
                HeightRequest="29"
                MinimumWidthRequest="73"
                Padding="13,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7"/>
                </Border.StrokeShape>

                <Border.Shadow>

                    <Shadow
                        Brush="Black"
                        Offset="0,1"
                        Radius="3"
                        Opacity="0.07"/>

                </Border.Shadow>

                <Label
                    x:Name="OverdueFilterLabel"
                    Text="Overdue"
                    Style="{StaticResource FilterChipLabel}"
                    FontSize="{StaticResource FontMicro}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="OnOverdueTasksClicked"/>

                </Border.GestureRecognizers>

            </Border>


            <!-- FILTER -->

            <Border
                x:Name="DateFilterBorder"
                Grid.Column="4"
                WidthRequest="31"
                HeightRequest="31"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                Stroke="Transparent"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <Image
                    x:Name="DateFilterIcon"
                    Source="blackfiltericon.png"
                    WidthRequest="15"
                    HeightRequest="15"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Open date filter"/>

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="OnTaskToolsClicked"/>

                </Border.GestureRecognizers>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- TASK CONTENT                                          -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="2"
            BackgroundColor="{StaticResource SurfaceBase}">


            <ScrollView
                x:Name="TasksScrollView"
                VerticalScrollBarVisibility="Never">

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,110">


                    <!-- ================================================= -->
                    <!-- ACTIVE TASKS                                      -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        x:Name="TodaySection"
                        Spacing="0">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="15,7,15,3"
                            BackgroundColor="{StaticResource SurfaceBase}">

                            <Label
                                x:Name="TodayHeaderLabel"
                                Text="Active Tasks (0)"
                                FontSize="{StaticResource FontMicro}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center"/>

                            <Image
                                x:Name="TodayToggleArrow"
                                Grid.Column="1"
                                Source="collapse.png"
                                WidthRequest="14"
                                HeightRequest="14"
                                Aspect="AspectFit"
                                Margin="8,0,2,0"
                                VerticalOptions="Center">

                                <Image.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="OnTodayToggleClicked"/>

                                </Image.GestureRecognizers>

                            </Image>

                        </Grid>


                        <VerticalStackLayout
                            x:Name="TodayTasksView"
                            BindableLayout.ItemTemplate="{StaticResource AdminDeadlineGroupTemplate}"
                            Spacing="0"/>

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- COMPLETED TODAY                                   -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        x:Name="CompletedTodaySection"
                        Spacing="0"
                        Margin="0,20,0,0">

                        <Grid
                            x:Name="CompletedTodaySectionHeader"
                            ColumnDefinitions="*,Auto"
                            Padding="15,7,15,4"
                            BackgroundColor="{StaticResource SurfaceBase}">

                            <Label
                                x:Name="CompletedTodayHeaderLabel"
                                Text="Completed Today (0)"
                                FontSize="{StaticResource FontMicro}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center"/>

                            <Image
                                x:Name="CompletedTodayToggleArrow"
                                Grid.Column="1"
                                Source="collapse.png"
                                WidthRequest="14"
                                HeightRequest="14"
                                Aspect="AspectFit"
                                Margin="8,0,2,0"
                                VerticalOptions="Center">

                                <Image.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="OnCompletedTodayToggleClicked"/>

                                </Image.GestureRecognizers>

                            </Image>

                        </Grid>


                        <VerticalStackLayout
                            x:Name="CompletedTodayTasksView"
                            BindableLayout.ItemTemplate="{StaticResource AdminDeadlineGroupTemplate}"
                            Spacing="0"/>


                        <!-- HISTORY -->

                        <Label
                            x:Name="CompletionHistoryLink"
                            Text="Check all completed tasks"
                            FontSize="{StaticResource FontMicro}"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDisabled}"
                            HorizontalTextAlignment="Center"
                            Margin="20,7,20,14">

                            <Label.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnCompletionHistoryClicked"/>

                            </Label.GestureRecognizers>

                        </Label>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </ScrollView>


            <!-- ================================================= -->
            <!-- EMPTY STATE                                       -->
            <!-- ================================================= -->

            <VerticalStackLayout
                x:Name="NoTodayTasksLabel"
                Spacing="8"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                TranslationY="-24">

                <Image
                    Source="notaskdue.png"
                    WidthRequest="150"
                    HeightRequest="150"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"/>

                <Label
                    x:Name="NoTasksTitleLabel"
                    Text="No tasks yet"
                    FontSize="{StaticResource FontBodySmall}"
                    FontAttributes="Bold"
                    Margin="0,6,0,0"
                    TextColor="{StaticResource TextPrimary}"
                    HorizontalTextAlignment="Center"/>

                <Label
                    x:Name="NoTasksMessageLabel"
                    Text="Create a task to get started."
                    FontSize="{StaticResource FontMicro}"
                    TextColor="{StaticResource TextTertiary}"
                    HorizontalTextAlignment="Center"/>

                <Label
                    x:Name="ViewOverdueEmptyLink"
                    Text="View overdue tasks"
                    FontSize="{StaticResource FontMicro}"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Accent500}"
                    HorizontalTextAlignment="Center"
                    Margin="0,4,0,0"
                    IsVisible="False">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="OnEmptyViewOverdueClicked"/>

                    </Label.GestureRecognizers>

                </Label>

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- CREATE TASK FAB                                   -->
            <!-- ================================================= -->

            <Border
                Style="{StaticResource Fab}"
                WidthRequest="48"
                HeightRequest="48"
                Margin="0,0,17,17"
                HorizontalOptions="End"
                VerticalOptions="End"
                SemanticProperties.Description="Create a new task">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>

                <Border.Shadow>

                    <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="6"
                        Opacity="0.16"/>

                </Border.Shadow>

                <Label
                    Text="+"
                    FontSize="27"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextInverse}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="OnCreateTaskClicked"/>

                </Border.GestureRecognizers>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- TASK TOOLS                                            -->
        <!-- ===================================================== -->

        <Grid
            x:Name="TaskToolsOverlay"
            Grid.Row="2"
            ZIndex="100"
            IsVisible="False">

            <Button
                Clicked="OnTaskToolsDismissClicked"
                BackgroundColor="Transparent"
                BorderWidth="0"/>


            <Border
                WidthRequest="220"
                Margin="0,4,15,0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Style="{StaticResource DropdownPanel}">

                <VerticalStackLayout Spacing="2">


                    <!-- DATE FILTER -->

                    <Border
                        Style="{StaticResource DropdownOption}">

                        <Grid
                            ColumnDefinitions="24,*"
                            ColumnSpacing="10">

                            <Image
                                Source="blackfiltericon.png"
                                WidthRequest="17"
                                HeightRequest="17"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Date filter"
                                Style="{StaticResource DropdownOptionLabel}"/>

                        </Grid>

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnTaskToolsDateFilterClicked"/>

                        </Border.GestureRecognizers>

                    </Border>


                    <!-- COMPLETION HISTORY -->

                    <Border
                        Style="{StaticResource DropdownOption}">

                        <Grid
                            ColumnDefinitions="24,*"
                            ColumnSpacing="10">

                            <Image
                                Source="completedtask.png"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Completion history"
                                Style="{StaticResource DropdownOptionLabel}"/>

                        </Grid>

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnTaskToolsHistoryClicked"/>

                        </Border.GestureRecognizers>

                    </Border>

                </VerticalStackLayout>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- BOTTOM NAVIGATION                                     -->
        <!-- ===================================================== -->

        <local:BottomNavigationBar
            Grid.Row="3"
            ActiveTab="Tasks"/>

    </Grid>

</base:EduTaskPage>