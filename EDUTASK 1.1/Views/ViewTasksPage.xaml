<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:EDUTASK_1._1.ViewModels"
             xmlns:models="clr-namespace:EDUTASK_1._1.Models"
             x:Class="EDUTASK_1._1.Views.ViewTasksPage"
             x:DataType="viewModels:TaskListViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F7FA">
    <Grid Padding="15" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="All Tasks" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50"/>
                <Label Text="Select a task to view or edit its details" FontSize="12" TextColor="Gray"/>
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Create Task"
                    Clicked="OnCreateClicked"
                    BackgroundColor="#27AE60"
                    TextColor="White"
                    CornerRadius="8"/>
        </Grid>

        <RefreshView Grid.Row="1"
                     x:Name="TaskRefreshView"
                     Command="{Binding RefreshCommand}">
            <CollectionView x:Name="TaskCollectionView"
                            ItemsSource="{Binding Tasks}"
                            SelectionMode="Single"
                            SelectionChanged="OnTaskSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" HorizontalOptions="Center">
                        <Label Text="No tasks found" FontSize="18" HorizontalOptions="Center"/>
                        <Label Text="Create a task to get started." TextColor="Gray" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AdministratorTaskItem">
                        <Border Margin="0,0,0,10" Padding="14" BackgroundColor="White" Stroke="#E1E8ED">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" TextColor="#2C3E50"/>
                                <Label Grid.Column="1" Text="{Binding Priority}" TextColor="{Binding PriorityColor}" FontAttributes="Bold"/>
                                <Label Grid.Row="1" Text="{Binding TeacherName}" TextColor="Gray"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Status}" TextColor="{Binding StatusColor}"/>
                                <Label Grid.Row="2" Text="{Binding DeadlineDisplay, StringFormat='Deadline: {0}'}" FontSize="12" TextColor="#7F8C8D"/>
                                <Button Grid.Row="2"
                                        Grid.Column="1"
                                        Text="Delete"
                                        FontSize="12"
                                        Padding="10,4"
                                        BackgroundColor="#C0392B"
                                        TextColor="White"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnDeleteClicked"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
