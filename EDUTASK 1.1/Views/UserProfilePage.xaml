<?xml version="1.0" encoding="utf-8" ?>
<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EDUTASK_1._1.Views"
             x:Class="EDUTASK_1._1.Views.UserProfilePage"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceMuted}">

    <!--
        Profile.

        The top profile area uses the same navy visual treatment as the
        reference design while keeping all existing bindings, names,
        events, menus, and profile functionality unchanged.
    -->

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===================================================== -->
        <!-- NAVY PROFILE HEADER                                   -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                BackgroundColor="#111C3A"
                Stroke="Transparent"
                StrokeThickness="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,12,12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="0">

                <!-- TOP APP BAR -->
                <Grid x:Name="ProfileAppBar"
                      Padding="18,14"
                      BackgroundColor="Transparent">

                    <ImageButton x:Name="ProfileBackButton"
                                 IsVisible="False"
                                 ZIndex="2"
                                 Source="whitebackicon.png"
                                 Clicked="OnProfileBackClicked"
                                 Pressed="OnProfileBackPressed"
                                 Released="OnProfileBackReleased"
                                 WidthRequest="42"
                                 HeightRequest="42"
                                 Padding="10"
                                 CornerRadius="12"
                                 BackgroundColor="{StaticResource ActionDismiss}"
                                 BorderWidth="0"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Center"
                                 SemanticProperties.Description="Back to user management"
                                 ToolTipProperties.Text="Back to user management"/>

                    <Label x:Name="ProfilePageTitleLabel"
                           Text="Profile"
                           InputTransparent="True"
                           FontSize="{StaticResource FontHeading}"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1"/>

                    <Border HorizontalOptions="End"
                            VerticalOptions="Center"
                            Padding="0"
                            WidthRequest="84"
                            HeightRequest="42"
                            BackgroundColor="{StaticResource SurfaceBase}"
                            StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>

                        <HorizontalStackLayout Spacing="0">

                            <ImageButton x:Name="ProfileEditButton"
                                         Source="profiledit.png"
                                         Clicked="OnProfileEditClicked"
                                         Pressed="OnProfileEditPressed"
                                         Released="OnProfileEditReleased"
                                         BackgroundColor="{StaticResource SurfaceBase}"
                                         BorderWidth="0"
                                         Padding="10"
                                         WidthRequest="42"
                                         HeightRequest="42"
                                         CornerRadius="8"
                                         Aspect="AspectFit"
                                         SemanticProperties.Description="Edit profile"
                                         ToolTipProperties.Text="Edit profile"/>

                            <ImageButton x:Name="ProfileMenuButton"
                                         Source="dotmenu.png"
                                         Clicked="OnProfileMenuClicked"
                                         Pressed="OnProfileMenuPressed"
                                         Released="OnProfileMenuReleased"
                                         BackgroundColor="{StaticResource SurfaceBase}"
                                         BorderWidth="0"
                                         Padding="10"
                                         WidthRequest="42"
                                         HeightRequest="42"
                                         CornerRadius="8"
                                         Aspect="AspectFit"
                                         SemanticProperties.Description="Profile options"
                                         ToolTipProperties.Text="Profile options"/>

                        </HorizontalStackLayout>

                    </Border>

                </Grid>


                <!-- PROFILE IDENTITY -->
                <Grid Padding="20,4,20,18"
                      ColumnDefinitions="88,*"
                      ColumnSpacing="16">

                    <Border WidthRequest="88"
                            HeightRequest="88"
                            StrokeThickness="0"
                            BackgroundColor="{Binding AvatarColor}"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="44"/>
                        </Border.StrokeShape>

                        <Grid>

                            <Label Text="{Binding AvatarInitials}"
                                   FontSize="{StaticResource FontDisplay}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextInverse}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding ShowInitials}"/>

                            <Image Source="{Binding Profile_photo}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding HasProfilePhoto}"/>

                        </Grid>

                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">

                        <Label Text="{Binding FullName}"
                               FontSize="{StaticResource FontTitleLarge}"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               LineBreakMode="TailTruncation"/>

                        <Label Text="{Binding UsernameDisplay}"
                               FontSize="{StaticResource FontBody}"
                               TextColor="#D7DEEE"
                               LineBreakMode="TailTruncation"/>

                    </VerticalStackLayout>

                </Grid>

            </VerticalStackLayout>

        </Border>


        <!-- ===================================================== -->
        <!-- PROFILE CONTENT                                       -->
        <!-- ===================================================== -->

        <ScrollView x:Name="ProfileScrollView"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Padding="20,12,20,28"
                                 Spacing="0">

                <!-- Information -->
                <Label x:Name="InformationHeadingLabel"
                       Text="Information"
                       Style="{StaticResource ReportSectionHeading}"
                       Margin="0,0,0,10"/>

                <!-- Email and phone read as links because they are: tapping either
                     copies it, the same as the overflow menu does. -->

                <Grid ColumnDefinitions="30,*"
                      ColumnSpacing="10"
                      HeightRequest="32">

                    <Image Source="profileemail.png"
                           WidthRequest="18"
                           HeightRequest="18"
                           Aspect="AspectFit"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="1"
                           Text="{Binding Email}"
                           FontSize="{StaticResource FontBody}"
                           TextColor="{StaticResource Accent500}"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           SemanticProperties.Description="Email address, tap to copy"/>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCopyEmailTapped"/>
                    </Grid.GestureRecognizers>

                </Grid>


                <Grid ColumnDefinitions="30,*"
                      ColumnSpacing="10"
                      HeightRequest="32">

                    <Image Source="profilephone.png"
                           WidthRequest="18"
                           HeightRequest="18"
                           Aspect="AspectFit"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="1"
                           Text="{Binding Contact_number}"
                           FontSize="{StaticResource FontBody}"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           SemanticProperties.Description="Phone number, tap to copy"/>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCopyPhoneTapped"/>
                    </Grid.GestureRecognizers>

                </Grid>


                <!-- ================================================= -->
                <!-- DIRECTOR PROFILE                                  -->
                <!-- ================================================= -->

                <VerticalStackLayout x:Name="DirectorProfileSection"
                                     IsVisible="False"
                                     Spacing="10">

                    <Label Text="Account Details"
                           Style="{StaticResource ReportSectionHeading}"
                           Margin="0,28,0,2"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <!-- ROLE -->

                        <Border Padding="12,10"
                                BackgroundColor="{StaticResource Accent100}"
                                Stroke="{StaticResource Accent200}"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Role"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label x:Name="DirectorRoleLabel"
                                       FontSize="{StaticResource FontBody}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Accent600}"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- STATUS -->

                        <Border Grid.Column="1"
                                Padding="12,10"
                                BackgroundColor="{StaticResource StatusSuccessSurface}"
                                Stroke="{StaticResource StatusSuccessBorder}"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Status"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label x:Name="DirectorStatusLabel"
                                       FontSize="{StaticResource FontBody}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource StatusSuccess}"/>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>


                    <!-- USERNAME + MEMBER SINCE -->

                    <Border Padding="14,11"
                            BackgroundColor="{StaticResource SurfaceBase}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,1,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="9">

                            <Label Text="Username"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Label x:Name="DirectorUsernameLabel"
                                   Grid.Column="1"
                                   FontSize="{StaticResource FontBodySmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>

                            <BoxView Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Color="{StaticResource BorderSubtle}"/>

                            <Label Grid.Row="2"
                                   Text="Member since"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Label x:Name="DirectorMemberSinceLabel"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   FontSize="{StaticResource FontBodySmall}"
                                   TextColor="{StaticResource TextPrimary}"/>

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- STAFF PROFILE                                     -->
                <!-- ================================================= -->

                <VerticalStackLayout x:Name="StaffProfileSection"
                                     IsVisible="False"
                                     Spacing="10">

                    <Label Text="Account Details"
                           Style="{StaticResource ReportSectionHeading}"
                           Margin="0,28,0,2"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Border Padding="12,10"
                                BackgroundColor="{StaticResource Accent100}"
                                Stroke="{StaticResource Accent200}"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Role"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label x:Name="StaffRoleLabel"
                                       FontSize="{StaticResource FontBody}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Accent600}"/>

                            </VerticalStackLayout>

                        </Border>


                        <Border Grid.Column="1"
                                Padding="12,10"
                                BackgroundColor="{StaticResource StatusSuccessSurface}"
                                Stroke="{StaticResource StatusSuccessBorder}"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Account status"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label x:Name="StaffStatusLabel"
                                       FontSize="{StaticResource FontBody}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource StatusSuccess}"/>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>


                    <Border Padding="14,11"
                            BackgroundColor="{StaticResource SurfaceBase}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,1,Auto,1,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="9">

                            <Label Text="Username"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Label x:Name="StaffUsernameLabel"
                                   Grid.Column="1"
                                   FontSize="{StaticResource FontBodySmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>

                            <BoxView Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Color="{StaticResource BorderSubtle}"/>

                            <Label Grid.Row="2"
                                   Text="Member since"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Label x:Name="StaffMemberSinceLabel"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   FontSize="{StaticResource FontBodySmall}"
                                   TextColor="{StaticResource TextPrimary}"/>

                            <BoxView Grid.Row="3"
                                     Grid.ColumnSpan="2"
                                     Color="{StaticResource BorderSubtle}"/>

                            <Label Grid.Row="4"
                                   Text="Last activity"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Label x:Name="StaffLastActivityLabel"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   FontSize="{StaticResource FontBodySmall}"
                                   TextColor="{StaticResource TextPrimary}"/>

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- TEACHER DIRECTORY ACCOUNT                         -->
                <!-- ================================================= -->

                <VerticalStackLayout x:Name="TeacherDirectoryAccountSection"
                                     IsVisible="False"
                                     Spacing="10">

                    <Label Text="Account Details"
                           Style="{StaticResource ReportSectionHeading}"
                           Margin="0,28,0,2"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Border Padding="12,10"
                                BackgroundColor="{StaticResource Accent100}"
                                Stroke="{StaticResource Accent200}"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Role"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label Text="Teacher"
                                       FontSize="{StaticResource FontBody}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Accent600}"/>

                            </VerticalStackLayout>

                        </Border>


                        <Border x:Name="TeacherDirectoryStatusCard"
                                Grid.Column="1"
                                Padding="12,10"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Status"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label x:Name="TeacherDirectoryStatusLabel"
                                       FontSize="{StaticResource FontBody}"
                                       FontAttributes="Bold"/>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>


                    <Border Padding="14,11"
                            BackgroundColor="{StaticResource SurfaceBase}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,1,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="9">

                            <Label Text="Username"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Label x:Name="TeacherDirectoryUsernameLabel"
                                   Grid.Column="1"
                                   FontSize="{StaticResource FontBodySmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>

                            <BoxView Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Color="{StaticResource BorderSubtle}"/>

                            <Label Grid.Row="2"
                                   Text="Member since"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Label x:Name="TeacherDirectoryMemberSinceLabel"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   FontSize="{StaticResource FontBodySmall}"
                                   TextColor="{StaticResource TextPrimary}"/>

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- ACCOUNT MANAGEMENT                                -->
                <!-- ================================================= -->

                <VerticalStackLayout x:Name="AccountManagementSection"
                                     IsVisible="False"
                                     Spacing="10">

                    <Label Text="Account Management"
                           Style="{StaticResource ReportSectionHeading}"
                           Margin="0,28,0,2"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Border Padding="12,10"
                                BackgroundColor="{StaticResource Accent100}"
                                Stroke="{StaticResource Accent200}"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Role"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label x:Name="ManagedRoleLabel"
                                       FontSize="{StaticResource FontBody}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Accent600}"/>

                            </VerticalStackLayout>

                        </Border>


                        <Border x:Name="ManagedStatusCard"
                                Grid.Column="1"
                                Padding="12,10"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Status"
                                       FontSize="{StaticResource FontCaption}"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label x:Name="ManagedStatusLabel"
                                       FontSize="{StaticResource FontBody}"
                                       FontAttributes="Bold"/>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>


                    <Border Padding="14,12"
                            BackgroundColor="{StaticResource SurfaceBase}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="4">

                            <Label Text="Approval"
                                   FontSize="{StaticResource FontCaption}"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Label x:Name="ManagedApprovalLabel"
                                   FontSize="{StaticResource FontBodySmall}"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- OVERVIEW                                           -->
                <!-- ================================================= -->

                <VerticalStackLayout x:Name="OverviewSection"
                                     Spacing="0">

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,30,0,14">

                        <Label Text="Overview"
                               Style="{StaticResource ReportSectionHeading}"/>

                        <Label x:Name="LastUpdatedLabel"
                               Grid.Column="1"
                               Text="Updated just now"
                               FontSize="{StaticResource FontCaption}"
                               TextColor="{StaticResource TextTertiary}"
                               VerticalOptions="End"/>

                    </Grid>


                    <Border BackgroundColor="{StaticResource SurfaceBase}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            Padding="14,16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>


                        <Grid x:Name="TaskOverviewRow"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="20"
                              SizeChanged="OnTaskOverviewSizeChanged">


                            <!-- CHART -->

                            <Grid VerticalOptions="Center"
                                  HorizontalOptions="Center">

                                <GraphicsView x:Name="TaskChart"
                                              WidthRequest="140"
                                              HeightRequest="140"
                                              HorizontalOptions="Center"
                                              BackgroundColor="Transparent"/>

                                <Label Text="{Binding CompletedPercentage, StringFormat='{0}%'}"
                                       IsVisible="{Binding HasTasks}"
                                       FontSize="{StaticResource FontTitle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       InputTransparent="True"/>

                                <Label Text="No tasks yet"
                                       IsVisible="{Binding HasNoTasks}"
                                       FontSize="{StaticResource FontBodySmall}"
                                       TextColor="{StaticResource TextTertiary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       InputTransparent="True"/>

                            </Grid>


                            <!-- LEGEND -->

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="14"
                                                 VerticalOptions="Center">


                                <!-- COMPLETED -->

                                <Grid x:Name="CompletedLegendRow"
                                      ColumnDefinitions="12,*,Auto"
                                      ColumnSpacing="12">

                                    <Border WidthRequest="12"
                                            HeightRequest="12"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource ChartCompleted}"
                                            VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>

                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="Completed"
                                           FontSize="{StaticResource FontBody}"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Column="2"
                                           Text="{Binding CompletedCount}"
                                           FontSize="{StaticResource FontBody}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"/>

                                </Grid>


                                <!-- PENDING / ONGOING -->

                                <Grid x:Name="PendingLegendRow"
                                      ColumnDefinitions="12,*,Auto"
                                      ColumnSpacing="12">

                                    <Border WidthRequest="12"
                                            HeightRequest="12"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource ChartOngoing}"
                                            VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>

                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="{Binding PendingLabel}"
                                           FontSize="{StaticResource FontBody}"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Column="2"
                                           Text="{Binding PendingCount}"
                                           FontSize="{StaticResource FontBody}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"/>

                                </Grid>


                                <!-- OVERDUE -->

                                <Grid x:Name="OverdueLegendRow"
                                      ColumnDefinitions="12,*,Auto"
                                      ColumnSpacing="12">

                                    <Border WidthRequest="12"
                                            HeightRequest="12"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource ChartOverdue}"
                                            VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>

                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="Overdue"
                                           FontSize="{StaticResource FontBody}"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Column="2"
                                           Text="{Binding OverdueCount}"
                                           FontSize="{StaticResource FontBody}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"/>

                                </Grid>


                                <BoxView Style="{StaticResource Divider}"
                                         Margin="0,2"/>


                                <!-- TOTAL -->

                                <Grid ColumnDefinitions="12,*,Auto"
                                      ColumnSpacing="12">

                                    <Label Grid.Column="1"
                                           Text="{Binding TotalLabel}"
                                           FontSize="{StaticResource FontBody}"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Column="2"
                                           Text="{Binding TotalCount}"
                                           FontSize="{StaticResource FontBody}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"/>

                                </Grid>

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>


        <!-- ===================================================== -->
        <!-- MANAGED ACCOUNT ACTIONS                               -->
        <!-- ===================================================== -->

        <Border x:Name="ManagedActionsFooter"
                Grid.Row="1"
                ZIndex="10"
                IsVisible="False"
                Padding="20,12,20,18"
                BackgroundColor="{StaticResource SurfaceMuted}"
                StrokeThickness="0"
                VerticalOptions="End">

            <VerticalStackLayout Spacing="10">

                <Button x:Name="PromoteToDirectorButton"
                        Text="Promote to Director"
                        Clicked="OnPromoteToDirectorClicked"
                        HeightRequest="50"
                        CornerRadius="25"
                        BackgroundColor="{StaticResource Accent500}"
                        TextColor="{StaticResource TextInverse}"
                        FontAttributes="Bold"/>

                <Button x:Name="ManagedAccountStateButton"
                        Clicked="OnManagedAccountStateClicked"
                        HeightRequest="50"
                        CornerRadius="25"
                        BorderWidth="1"
                        FontAttributes="Bold"/>

            </VerticalStackLayout>

        </Border>


        <!-- ===================================================== -->
        <!-- BOTTOM NAVIGATION                                     -->
        <!-- ===================================================== -->

        <local:BottomNavigationBar x:Name="BottomTabBar"
                                   Grid.Row="2"
                                   ActiveTab="Profile"/>


        <!-- ===================================================== -->
        <!-- COPY TOAST                                            -->
        <!-- ===================================================== -->

        <Border x:Name="Toast"
                Grid.Row="1"
                ZIndex="20"
                IsVisible="False"
                Opacity="0"
                InputTransparent="True"
                BackgroundColor="{StaticResource Brand800}"
                StrokeThickness="0"
                Padding="18,10"
                Margin="0,0,0,18"
                HorizontalOptions="Center"
                VerticalOptions="End">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>

            <Label x:Name="ToastLabel"
                   FontSize="{StaticResource FontBodySmall}"
                   TextColor="{StaticResource TextInverse}"/>

        </Border>


        <!-- ===================================================== -->
        <!-- PROFILE MENU OVERLAY                                  -->
        <!-- ===================================================== -->

        <Grid x:Name="ProfileMenuOverlay"
              Grid.RowSpan="3"
              ZIndex="100"
              IsVisible="False"
              InputTransparent="False">

            <BoxView x:Name="ProfileMenuBackdrop"
                     Color="{StaticResource ScrimLight}">

                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileMenuBackdropTapped"/>
                </BoxView.GestureRecognizers>

            </BoxView>


            <Border x:Name="ProfileMenuSheet"
                    Padding="0,10,0,18"
                    BackgroundColor="{StaticResource SurfaceBase}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    VerticalOptions="End">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0"/>
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowOverlay}"
                            Offset="0,-4"
                            Radius="16"
                            Opacity="0.55"/>
                </Border.Shadow>


                <VerticalStackLayout Spacing="0">

                    <!-- DRAG HANDLE -->

                    <BoxView WidthRequest="42"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="{StaticResource Slate200}"
                             HorizontalOptions="Center"
                             Margin="0,0,0,8"/>


                    <!-- COPY EMAIL -->

                    <Border HeightRequest="46"
                            Padding="28,0"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            SemanticProperties.Description="Copy email">

                        <Label Text="Copy email"
                               FontSize="{StaticResource FontBody}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalTextAlignment="Center"/>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCopyEmailOptionTapped"/>
                        </Border.GestureRecognizers>

                    </Border>


                    <BoxView HeightRequest="1"
                             Color="{StaticResource BorderDefault}"
                             HorizontalOptions="Fill"/>


                    <!-- COPY PHONE -->

                    <Border HeightRequest="46"
                            Padding="28,0"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            SemanticProperties.Description="Copy phone number">

                        <Label Text="Copy phone number"
                               FontSize="{StaticResource FontBody}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalTextAlignment="Center"/>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCopyPhoneOptionTapped"/>
                        </Border.GestureRecognizers>

                    </Border>

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</base:EduTaskPage>
