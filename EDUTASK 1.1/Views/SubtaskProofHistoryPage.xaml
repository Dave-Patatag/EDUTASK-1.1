<?xml version="1.0" encoding="utf-8" ?>
<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base"
                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
                  x:Class="EDUTASK_1._1.Views.SubtaskProofHistoryPage"
                  Transition="Dialog"
                  BackgroundColor="{StaticResource Scrim}"
                  NavigationPage.HasNavigationBar="False">

    <Grid Padding="10,14">
        <Border x:Name="PopupPanel"
                WidthRequest="700"
                HeightRequest="480"
                Padding="12,14,12,16"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F7FAFF" Offset="0.62"/>
                    <GradientStop Color="#EFF5FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid IsClippedToBounds="True">
                <!-- Soft decoration remains behind the functional content. -->
                <shapes:Ellipse WidthRequest="210"
                                HeightRequest="150"
                                Fill="#DDEBFF"
                                Opacity="0.62"
                                HorizontalOptions="Start"
                                VerticalOptions="End"
                                TranslationX="-86"
                                TranslationY="72"/>
                <shapes:Ellipse WidthRequest="250"
                                HeightRequest="170"
                                Fill="#E4EFFF"
                                Opacity="0.72"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                TranslationX="98"
                                TranslationY="76"/>

                <Grid RowDefinitions="Auto,Auto,*,Auto"
                      RowSpacing="16"
                      ZIndex="1">

                    <!-- Header -->
                    <Grid x:Name="HistoryHeader"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">
                        <Border x:Name="HeaderIcon"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="10"
                                BackgroundColor="#E7F0FF"
                                StrokeThickness="0"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30"/>
                            </Border.StrokeShape>
                            <Image Source="file.png"
                                   Aspect="AspectFit"
                                   SemanticProperties.Description="Task submission document"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="1"
                                             VerticalOptions="Center">
                            <Label x:Name="TitleLabel"
                                   Text="Task Submission"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Brand800}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"/>
                            <Label Text="{Binding SubtaskTitle}"
                                   FontSize="{StaticResource FontBody}"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"/>
                        </VerticalStackLayout>

                        <Border x:Name="CloseButton"
                                Grid.Column="2"
                                WidthRequest="36"
                                HeightRequest="36"
                                BackgroundColor="#E8EDF5"
                                StrokeThickness="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                SemanticProperties.Description="Close task submission">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Label Text="&#x00D7;"
                                   FontSize="25"
                                   TextColor="{StaticResource Brand800}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TranslationY="-1"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <BoxView Grid.Row="1"
                             HeightRequest="1"
                             Margin="0,-5,0,0"
                             Color="#D9E5F6"/>

                    <!-- Submission table -->
                    <Border Grid.Row="2"
                            Padding="0"
                            BackgroundColor="{StaticResource SurfaceBase}"
                            Stroke="#E3E9F2"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,*">
                            <Grid x:Name="HistoryTableHeader"
                                  MinimumHeightRequest="48"
                                  Padding="8,0"
                                  ColumnDefinitions="40,*,Auto,Auto"
                                  ColumnSpacing="7"
                                  BackgroundColor="{StaticResource Brand800}">
                                <Label x:Name="NumberHeader"
                                       Text="#"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextInverse}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"
                                       SemanticProperties.Description="Submission number"/>
                                <Label x:Name="DateHeader"
                                       Grid.Column="1"
                                       Text="Date &amp; Time"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextInverse}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="ProofHeader"
                                       Grid.Column="2"
                                       Text="Proof Files"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextInverse}"
                                       VerticalTextAlignment="Center"/>
                                <Label x:Name="StatusHeader"
                                       Grid.Column="3"
                                       Text="Status"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextInverse}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"/>
                            </Grid>

                            <CollectionView Grid.Row="1"
                                            ItemsSource="{Binding Attempts}"
                                            SelectionMode="None">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Padding="24"
                                                         VerticalOptions="Center"
                                                         Spacing="6">
                                        <Label Text="No submissions yet"
                                               FontSize="{StaticResource FontHeading}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="Submitted proof attempts will appear here."
                                               FontSize="{StaticResource FontLabel}"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid RowDefinitions="Auto,Auto,1"
                                              Padding="8,9,8,0"
                                              ColumnDefinitions="40,*,Auto,Auto"
                                              ColumnSpacing="7"
                                              MinimumHeightRequest="76">
                                            <Border WidthRequest="34"
                                                    HeightRequest="34"
                                                    BackgroundColor="#EEF3FA"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="22"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding AttemptDisplay}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Brand800}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="0"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding SubmittedDateDisplay}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"/>
                                                <Label Text="{Binding SubmittedTimeDisplay}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"/>
                                            </VerticalStackLayout>

                                            <Border Grid.Column="2"
                                                    Padding="8,7"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="{StaticResource Accent100}"
                                                    Stroke="#C8D9FF"
                                                    StrokeThickness="1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="5">
                                                    <Label Text="&#x25A4;"
                                                           FontSize="14"
                                                           TextColor="{StaticResource Accent500}"
                                                           VerticalTextAlignment="Center"/>
                                                    <Label Text="{Binding ViewFilesText}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Accent500}"
                                                           VerticalTextAlignment="Center"/>
                                                </HorizontalStackLayout>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnViewProofTapped"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                            </Border>

                                            <Border Grid.Column="3"
                                                    Padding="10,7"
                                                    MinimumWidthRequest="82"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="{Binding StatusSurfaceColor}"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="6"
                                                                       HorizontalOptions="Center">
                                                    <shapes:Ellipse WidthRequest="8"
                                                                    HeightRequest="8"
                                                                    Fill="{Binding StatusColor}"
                                                                    VerticalOptions="Center"/>
                                                    <Label Text="{Binding ValidationStatus}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding StatusColor}"
                                                           VerticalTextAlignment="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>

                                            <!-- Review controls are preserved and only add height to the pending row. -->
                                            <HorizontalStackLayout Grid.Row="1"
                                                                   Grid.Column="1"
                                                                   Grid.ColumnSpan="3"
                                                                   Margin="0,9,0,1"
                                                                   IsVisible="{Binding CanReview}"
                                                                   Spacing="8"
                                                                   HorizontalOptions="End">
                                                <ImageButton Source="confirmfile.png"
                                                             Clicked="OnApproveClicked"
                                                             WidthRequest="36"
                                                             HeightRequest="36"
                                                             Padding="7"
                                                             CornerRadius="9"
                                                             BackgroundColor="{StaticResource StatusSuccess}"
                                                             ToolTipProperties.Text="Approve submission"
                                                             SemanticProperties.Description="Approve this pending submission"/>
                                                <ImageButton Source="returnproof.png"
                                                             Clicked="OnReturnClicked"
                                                             WidthRequest="36"
                                                             HeightRequest="36"
                                                             Padding="7"
                                                             CornerRadius="9"
                                                             BackgroundColor="{StaticResource StatusDanger}"
                                                             ToolTipProperties.Text="Return submission"
                                                             SemanticProperties.Description="Request changes to this pending submission"/>
                                            </HorizontalStackLayout>

                                            <BoxView Grid.Row="2"
                                                     Grid.ColumnSpan="4"
                                                     HeightRequest="1"
                                                     Margin="0,12,0,0"
                                                     Color="#E4E9F1"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>

                    <Button x:Name="BackButton"
                            Grid.Row="3"
                            Text="&#x2190;   Back"
                            Clicked="OnCloseClicked"
                            WidthRequest="170"
                            HeightRequest="48"
                            Padding="18,0"
                            HorizontalOptions="Center"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            BackgroundColor="#3E4D69"
                            TextColor="{StaticResource TextInverse}"
                            SemanticProperties.Description="Close task submission"/>
                </Grid>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WindowWidths">
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter TargetName="PopupPanel" Property="Padding" Value="26,28,26,30"/>
                            <Setter TargetName="HeaderIcon" Property="WidthRequest" Value="64"/>
                            <Setter TargetName="HeaderIcon" Property="HeightRequest" Value="64"/>
                            <Setter TargetName="HeaderIcon" Property="Padding" Value="15"/>
                            <Setter TargetName="TitleLabel" Property="Label.FontSize" Value="28"/>
                            <Setter TargetName="CloseButton" Property="WidthRequest" Value="46"/>
                            <Setter TargetName="CloseButton" Property="HeightRequest" Value="46"/>
                            <Setter TargetName="HistoryTableHeader" Property="MinimumHeightRequest" Value="64"/>
                            <Setter TargetName="NumberHeader" Property="Label.FontSize" Value="14"/>
                            <Setter TargetName="DateHeader" Property="Label.FontSize" Value="14"/>
                            <Setter TargetName="ProofHeader" Property="Label.FontSize" Value="14"/>
                            <Setter TargetName="StatusHeader" Property="Label.FontSize" Value="14"/>
                            <Setter TargetName="BackButton" Property="WidthRequest" Value="216"/>
                            <Setter TargetName="BackButton" Property="HeightRequest" Value="60"/>
                            <Setter TargetName="BackButton" Property="Button.FontSize" Value="18"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </Grid>
</base:EduTaskPage>
