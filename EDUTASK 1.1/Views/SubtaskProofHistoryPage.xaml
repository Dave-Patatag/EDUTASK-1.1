<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EDUTASK_1._1.Models"
             x:Class="EDUTASK_1._1.Views.SubtaskProofHistoryPage"
             BackgroundColor="#99000000"
             NavigationPage.HasNavigationBar="False">
    <Grid Padding="16">
        <Border x:Name="PopupPanel"
                WidthRequest="560" HeightRequest="400"
                HorizontalOptions="Center" VerticalOptions="Center"
                Padding="18" BackgroundColor="#F8FAFC" Stroke="#D8DEE5">
            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Submission history" FontSize="20" FontAttributes="Bold" TextColor="#202936"/>
                <Label Text="{Binding SubtaskTitle}" FontSize="12" TextColor="#687786"
                       LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="✕" Clicked="OnCloseClicked"
                    WidthRequest="36" HeightRequest="36" Padding="0"
                    FontSize="13" TextColor="#243447"
                    BackgroundColor="#E2E7EC" CornerRadius="9"
                    SemanticProperties.Description="Close submission history"/>
        </Grid>

        <Border Grid.Row="1" Padding="0" BackgroundColor="White" Stroke="#D8DEE5">
            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="12,10" ColumnDefinitions="78,120,*,82" ColumnSpacing="8"
                      BackgroundColor="#EEF2F6">
                    <Label Text="Submission" FontSize="10" FontAttributes="Bold" TextColor="#3E4C5E"/>
                    <Label Grid.Column="1" Text="Date / Time" FontSize="10" FontAttributes="Bold" TextColor="#3E4C5E"/>
                    <Label Grid.Column="2" Text="Proof File" FontSize="10" FontAttributes="Bold" TextColor="#3E4C5E"/>
                    <Label Grid.Column="3" Text="Status" FontSize="10" FontAttributes="Bold" TextColor="#3E4C5E"/>
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding Attempts}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" VerticalOptions="Center" Spacing="5">
                            <Label Text="No submission history" FontSize="15" FontAttributes="Bold"
                                   TextColor="#243447" HorizontalTextAlignment="Center"/>
                            <Label Text="Submitted proof attempts will appear here."
                                   FontSize="11" TextColor="#687786" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="12,10" ColumnDefinitions="78,120,*,82" ColumnSpacing="8">
                                    <Label Text="{Binding AttemptDisplay}" FontSize="10" TextColor="#243447"/>
                                    <Label Grid.Column="1" Text="{Binding SubmittedAtDisplay}" FontSize="10"
                                           TextColor="#596574" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="2" Text="{Binding FileName}" FontSize="10"
                                           TextColor="#2563EB" TextDecorations="Underline"
                                           LineBreakMode="TailTruncation">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnViewProofTapped"
                                                                  CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Grid.Column="3" Text="{Binding ValidationStatus}" FontSize="10"
                                           FontAttributes="Bold" TextColor="{Binding StatusColor}"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#E1E5EA"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
        <HorizontalStackLayout x:Name="ReviewActionsPanel" Grid.Row="2"
                               IsVisible="False" HorizontalOptions="End" Spacing="8">
            <ImageButton Source="confirmfile.png" Clicked="OnApproveClicked"
                         WidthRequest="40" HeightRequest="40" Padding="7"
                         CornerRadius="9" BackgroundColor="#687786"
                         ToolTipProperties.Text="Approve latest submission"
                         SemanticProperties.Description="Approve latest pending submission"/>
            <ImageButton Source="returnproof.png" Clicked="OnReturnClicked"
                         WidthRequest="40" HeightRequest="40" Padding="7"
                         CornerRadius="9" BackgroundColor="#687786"
                         ToolTipProperties.Text="Return latest submission"
                         SemanticProperties.Description="Request changes to latest pending submission"/>
        </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
