<?xml version="1.0" encoding="utf-8" ?>
<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base"
                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:viewModels="clr-namespace:EDUTASK_1._1.ViewModels"
                  x:Class="EDUTASK_1._1.Views.AccountProfileDialog"
                  x:DataType="viewModels:ProfileViewModel"
                  Transition="BottomSheet"
                  BackgroundColor="{StaticResource Scrim}"
                  NavigationPage.HasNavigationBar="False"
                  Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <BoxView Grid.RowSpan="2" Color="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="DialogPanel"
                Grid.Row="1"
                HeightRequest="330"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                MinimumWidthRequest="0"
                MaximumHeightRequest="720"
                BackgroundColor="{StaticResource SurfaceBase}"
                Stroke="Transparent"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource ShadowOverlay}"
                        Offset="0,-4" Radius="16" Opacity="0.55"/>
            </Border.Shadow>

            <!-- The sheet receives a responsive explicit height in code.
                 The middle row uses the remaining space and scrolls only when
                 optional bio or management content needs it. -->
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <BoxView WidthRequest="42" HeightRequest="4" CornerRadius="2"
                         Color="{StaticResource Slate200}"
                         HorizontalOptions="Center" Margin="0,10,0,0"/>

                <Grid Grid.Row="1" Padding="16,10,12,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Profile details"
                               FontSize="{StaticResource FontHeading}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               SemanticProperties.HeadingLevel="Level1"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="&#x2715;"
                            Clicked="OnCloseClicked"
                            WidthRequest="36" HeightRequest="36"
                            MinimumWidthRequest="36" MinimumHeightRequest="36"
                            Padding="0" CornerRadius="18"
                            FontSize="{StaticResource FontBodySmall}"
                            BackgroundColor="{StaticResource ActionDismiss}"
                            TextColor="{StaticResource TextInverse}"
                            SemanticProperties.Description="Close profile details"/>
                </Grid>

                <ScrollView Grid.Row="2"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="16,2,16,10"
                                         HorizontalOptions="Fill"
                                         Spacing="0">
                        <Grid ColumnDefinitions="94,*" ColumnSpacing="14" Padding="0,8,0,14">
                            <Border WidthRequest="88" HeightRequest="88"
                                    HorizontalOptions="Start" VerticalOptions="Center"
                                    BackgroundColor="{Binding AvatarColor}"
                                    Stroke="{StaticResource SurfaceBase}" StrokeThickness="3">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="44"/>
                                </Border.StrokeShape>
                                <Grid>
                                    <Label Text="{Binding AvatarInitials}"
                                           IsVisible="{Binding ShowInitials}"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextInverse}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                    <Image Source="{Binding Profile_photo}"
                                           IsVisible="{Binding HasProfilePhoto}"
                                           Aspect="AspectFill"/>
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding FullName}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding UsernameDisplay}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextTertiary}"
                                       LineBreakMode="TailTruncation"/>
                                <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                                    <Border IsVisible="False" Padding="8,4" BackgroundColor="{StaticResource StatusInfoSurface}" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="5">
                                            <Image Source="profileposition.png" WidthRequest="13" HeightRequest="13"/>
                                            <Label x:Name="RoleLabel" FontSize="{StaticResource FontMicro}"
                                                   TextColor="{StaticResource StatusInfo}" VerticalTextAlignment="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border x:Name="StatusCard" Padding="8,4" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                        <Label x:Name="StatusLabel" FontSize="{StaticResource FontMicro}" FontAttributes="Bold"/>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Information"
                               Style="{StaticResource ReportSectionHeading}"
                               Margin="0,0,0,8"/>

                        <Border Padding="12,6"
                                BackgroundColor="{StaticResource SurfaceBase}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="40,*" ColumnSpacing="8" MinimumHeightRequest="48">
                                    <Border Padding="7" BackgroundColor="{StaticResource SurfaceSunken}" StrokeThickness="0"
                                            HorizontalOptions="Start" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Image Source="profileemail.png" WidthRequest="18" HeightRequest="18"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Email" FontSize="{StaticResource FontCaption}"
                                               TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding Email}" FontSize="13"
                                               TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}"/>

                                <Grid ColumnDefinitions="40,*" ColumnSpacing="8" MinimumHeightRequest="48">
                                    <Border Padding="7" BackgroundColor="{StaticResource SurfaceSunken}" StrokeThickness="0"
                                            HorizontalOptions="Start" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Image Source="profilephone.png" WidthRequest="18" HeightRequest="18"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Phone" FontSize="{StaticResource FontCaption}"
                                               TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding Contact_number}" FontSize="13"
                                               TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}"/>

                                <Grid ColumnDefinitions="40,*" ColumnSpacing="8" MinimumHeightRequest="48">
                                    <Border Padding="7" BackgroundColor="{StaticResource SurfaceSunken}" StrokeThickness="0"
                                            HorizontalOptions="Start" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Image Source="profilecalendar.png" WidthRequest="18" HeightRequest="18"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Member since" FontSize="{StaticResource FontCaption}"
                                               TextColor="{StaticResource TextTertiary}"/>
                                <Label x:Name="MemberSinceLabel" FontSize="13"
                                               TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout x:Name="ManagementActions"
                                     Grid.Row="3"
                                     IsVisible="False"
                                     Padding="16,8,16,18"
                                     Spacing="8">
                    <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}"/>
                    <Button x:Name="PromoteButton"
                            Text="Promote to Director"
                            Clicked="OnPromoteClicked"
                            HeightRequest="38"
                            CornerRadius="10"
                            FontSize="{StaticResource FontMicro}"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource Accent600}"
                            TextColor="{StaticResource TextInverse}"/>
                    <Button x:Name="AccountStateButton"
                            Text="Disable account"
                            Clicked="OnAccountStateClicked"
                            HeightRequest="38"
                            CornerRadius="10"
                            FontSize="{StaticResource FontMicro}"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource ActionDanger}"
                            BorderColor="{StaticResource ActionDanger}"
                            BorderWidth="0"
                            TextColor="{StaticResource TextInverse}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</base:EduTaskPage>
