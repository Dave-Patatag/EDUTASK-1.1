<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Class="EDUTASK_1._1.Views.EditProfilePage" NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False" BackgroundColor="White">
 <ScrollView>
  <VerticalStackLayout Padding="17,18,17,30" Spacing="0">
   <Grid ColumnDefinitions="40,*,40" HeightRequest="38">
    <ImageButton Source="backicon.png" Clicked="OnBackClicked" WidthRequest="32" HeightRequest="32" Padding="5" BackgroundColor="Transparent" VerticalOptions="Center" SemanticProperties.Description="Go back"/>
    <Label Grid.Column="1" Text="Edit profile" FontSize="16" FontAttributes="Bold" TextColor="#202124" HorizontalOptions="Center" VerticalOptions="Center"/>
   </Grid>

   <VerticalStackLayout Spacing="12" Margin="0,24,0,26">
    <Border WidthRequest="94" HeightRequest="94" BackgroundColor="{Binding AvatarColor}" Stroke="#E2C34F" StrokeThickness="1" HorizontalOptions="Center">
     <Border.StrokeShape><RoundRectangle CornerRadius="47"/></Border.StrokeShape>
     <Grid>
      <Label Text="{Binding AvatarInitials}" FontSize="31" TextColor="#202124" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding ShowInitials}"/>
      <Image Source="{Binding ProfilePhotoPath}" Aspect="AspectFill" IsVisible="{Binding HasProfilePhoto}"/>
     </Grid>
    </Border>
    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" Padding="13,8" HorizontalOptions="Center">
     <Border.StrokeShape><RoundRectangle CornerRadius="9"/></Border.StrokeShape>
     <HorizontalStackLayout Spacing="7"><Image Source="camera.png" WidthRequest="17" HeightRequest="17"/><Label Text="Edit photo" FontSize="13" FontAttributes="Bold" TextColor="#30343B"/></HorizontalStackLayout>
     <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChangePhotoTapped"/></Border.GestureRecognizers>
    </Border>
   </VerticalStackLayout>

   <VerticalStackLayout Spacing="15">
    <VerticalStackLayout Spacing="7">
     <Label Text="Full name" FontSize="14" FontAttributes="Bold" TextColor="#202124"/>
     <Border Stroke="#E1E3E7" StrokeThickness="1" BackgroundColor="White" Padding="13,1" HeightRequest="50"><Border.StrokeShape><RoundRectangle CornerRadius="7"/></Border.StrokeShape><Entry x:Name="FullNameEntry" Text="{Binding FullName}" FontSize="13" TextColor="#4B4F56" BackgroundColor="Transparent" Margin="-2,0"/></Border>
    </VerticalStackLayout>
    <VerticalStackLayout Spacing="7">
     <Label Text="Phone number" FontSize="14" FontAttributes="Bold" TextColor="#202124"/>
     <Border Stroke="#E1E3E7" StrokeThickness="1" BackgroundColor="White" Padding="13,1" HeightRequest="50"><Border.StrokeShape><RoundRectangle CornerRadius="7"/></Border.StrokeShape><Entry x:Name="PhoneEntry" Text="{Binding ContactNumber}" Keyboard="Telephone" MaxLength="11" FontSize="13" TextColor="#4B4F56" BackgroundColor="Transparent" Margin="-2,0"/></Border>
    </VerticalStackLayout>
    <VerticalStackLayout Spacing="7">
     <Label Text="Email" FontSize="14" FontAttributes="Bold" TextColor="#202124"/>
     <Border Stroke="#E1E3E7" StrokeThickness="1" BackgroundColor="White" Padding="13,1" HeightRequest="50"><Border.StrokeShape><RoundRectangle CornerRadius="7"/></Border.StrokeShape><Entry x:Name="EmailEntry" Text="{Binding Email}" Keyboard="Email" FontSize="13" TextColor="#4B4F56" BackgroundColor="Transparent" Margin="-2,0"/></Border>
    </VerticalStackLayout>
    <VerticalStackLayout Spacing="7">
     <Label Text="Username" FontSize="14" FontAttributes="Bold" TextColor="#202124"/>
     <Border Stroke="#E1E3E7" StrokeThickness="1" BackgroundColor="White" Padding="13,1" HeightRequest="50"><Border.StrokeShape><RoundRectangle CornerRadius="7"/></Border.StrokeShape><Entry x:Name="UsernameEntry" Text="{Binding Username}" FontSize="13" TextColor="#4B4F56" BackgroundColor="Transparent" Margin="-2,0"/></Border>
    </VerticalStackLayout>
    <VerticalStackLayout Spacing="7">
     <Label Text="Date of birth" FontSize="14" FontAttributes="Bold" TextColor="#202124"/>
     <Border Stroke="#E1E3E7" StrokeThickness="1" BackgroundColor="White" Padding="13,1" HeightRequest="50"><Border.StrokeShape><RoundRectangle CornerRadius="7"/></Border.StrokeShape><DatePicker x:Name="BirthdatePicker" Date="{Binding Birthdate}" MaximumDate="{x:Static sys:DateTime.Today}" Format="dd/MM/yyyy" FontSize="13" TextColor="#4B4F56" BackgroundColor="Transparent" Margin="-10,0"/></Border>
    </VerticalStackLayout>
   </VerticalStackLayout>

   <Border StrokeThickness="0" BackgroundColor="#292A70" Padding="0" Margin="0,24,0,8" WidthRequest="235" HorizontalOptions="Center">
    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
    <Label Text="Save changes" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Padding="0,14"/>
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveChangesClicked"/></Border.GestureRecognizers>
   </Border>
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>