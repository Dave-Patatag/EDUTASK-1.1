<?xml version="1.0" encoding="utf-8" ?>
<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base"
                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  x:Class="EDUTASK_1._1.Views.FlyoutMenuPage"
                  NavigationPage.HasNavigationBar="False"
                  Shell.NavBarIsVisible="False"
                  BackgroundColor="{StaticResource SurfaceMuted}">

    <base:EduTaskPage.Resources>
        <Style x:Key="FlyoutMenuRow" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceBase}"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HeightRequest" Value="48"/>
            <Setter Property="MinimumHeightRequest" Value="48"/>
        </Style>
        <Style x:Key="FlyoutMenuIcon" TargetType="Image">
            <Setter Property="WidthRequest" Value="22"/>
            <Setter Property="HeightRequest" Value="22"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
        <Style x:Key="FlyoutMenuLabel" TargetType="Label">
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </base:EduTaskPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Image Source="edutasklogo.png"
                   HeightRequest="100"
                   Aspect="AspectFit"
                   Margin="0,28,0,32"
                   HorizontalOptions="Center"/>
            <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" BackgroundColor="{StaticResource SurfaceMuted}">
            <VerticalStackLayout Padding="10,12" Spacing="4">
                <Label Text="MANAGE"
                       FontSize="{StaticResource FontMicro}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Slate400}"
                       Margin="4,0,0,2"/>

                <Border x:Name="TaskSummaryItemBorder" Style="{StaticResource FlyoutMenuRow}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="40,*">
                        <Image Grid.Column="0" Source="summaryreport.png" Style="{StaticResource FlyoutMenuIcon}"/>
                        <Label Grid.Column="1" Text="Task Summary" Style="{StaticResource FlyoutMenuLabel}"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTaskSummaryTapped"/>
                        <PointerGestureRecognizer PointerPressed="OnItemPointerPressed"
                                                  PointerReleased="OnItemPointerReleased"
                                                  PointerExited="OnItemPointerReleased"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="CalendarItemBorder" Style="{StaticResource FlyoutMenuRow}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="40,*">
                        <Image Grid.Column="0" Source="flyoutcalendar.png" Style="{StaticResource FlyoutMenuIcon}"/>
                        <Label Grid.Column="1" Text="Calendar" Style="{StaticResource FlyoutMenuLabel}"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalendarTapped"/>
                        <PointerGestureRecognizer PointerPressed="OnItemPointerPressed"
                                                  PointerReleased="OnItemPointerReleased"
                                                  PointerExited="OnItemPointerReleased"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="TeachersStaffItemBorder" Style="{StaticResource FlyoutMenuRow}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="40,*">
                        <Image Grid.Column="0" Source="teacherandstaff.png" Style="{StaticResource FlyoutMenuIcon}"/>
                        <Label x:Name="TeachersStaffMenuLabel" Grid.Column="1"
                               Text="Teachers &amp; Staff" Style="{StaticResource FlyoutMenuLabel}"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTeachersStaffTapped"/>
                        <PointerGestureRecognizer PointerPressed="OnItemPointerPressed"
                                                  PointerReleased="OnItemPointerReleased"
                                                  PointerExited="OnItemPointerReleased"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="CompletionHistoryItemBorder" Style="{StaticResource FlyoutMenuRow}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="40,*">
                        <Image Grid.Column="0" Source="completionhistory.png" Style="{StaticResource FlyoutMenuIcon}"/>
                        <Label Grid.Column="1" Text="Completion History" Style="{StaticResource FlyoutMenuLabel}"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCompletionHistoryTapped"/>
                        <PointerGestureRecognizer PointerPressed="OnItemPointerPressed"
                                                  PointerReleased="OnItemPointerReleased"
                                                  PointerExited="OnItemPointerReleased"/>
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="10,0,10,16">
            <Border Style="{StaticResource FlyoutMenuRow}">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <Grid ColumnDefinitions="40,*">
                    <Image Grid.Column="0" Source="landingpage.png" Style="{StaticResource FlyoutMenuIcon}"/>
                    <Label Grid.Column="1" Text="Log out" Style="{StaticResource FlyoutMenuLabel}" TextColor="{StaticResource StatusDanger}"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutTapped"/>
                    <PointerGestureRecognizer PointerPressed="OnItemPointerPressed"
                                              PointerReleased="OnItemPointerReleased"
                                              PointerExited="OnItemPointerReleased"/>
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>

    </Grid>
</base:EduTaskPage>
