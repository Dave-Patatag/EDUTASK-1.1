<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EDUTASK_1._1.Views.TaskDiscussionPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8FA">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14"
              Padding="20,17" BackgroundColor="#5D6D7E">
            <ImageButton x:Name="BackButton" Source="backicon.png" Clicked="OnBackClicked" WidthRequest="34" HeightRequest="34" Padding="7" CornerRadius="8" BackgroundColor="White" SemanticProperties.Description="Go back"/>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Discussion" FontSize="19" FontAttributes="Bold" TextColor="White"/>
                <HorizontalStackLayout Spacing="3">
                    <Label Text="Task:" FontSize="10" TextColor="#DCE2E7"/>
                    <Label x:Name="TaskTitleLabel" FontSize="10" FontAttributes="Bold"
                           TextColor="White" LineBreakMode="TailTruncation"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <RefreshView x:Name="CommentsRefreshView" Grid.Row="1"
                     Refreshing="OnRefreshing" Padding="16,14">
            <CollectionView x:Name="CommentsView">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Grid Padding="8,42">
                        <Border BackgroundColor="White" Stroke="#D7DCE2"
                                StrokeThickness="1" Padding="24,28"
                                HorizontalOptions="Fill" VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                                <Border WidthRequest="42" HeightRequest="42"
                                        BackgroundColor="#EEF1F4" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="21"/></Border.StrokeShape>
                                    <Label Text="&#x270E;" FontSize="19" TextColor="#687786"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="No comments yet" FontSize="15" FontAttributes="Bold"
                                       TextColor="#374151" HorizontalOptions="Center"/>
                                <Label Text="Start the conversation with a comment or note."
                                       FontSize="11" TextColor="#9AA4AF"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" HorizontalOptions="Fill">
                            <Border Grid.Column="{Binding MessageColumn}"
                                    IsVisible="{Binding IsRegularComment}"
                                    Padding="12,10" MaximumWidthRequest="380"
                                    BackgroundColor="{Binding BubbleColor}"
                                    Stroke="{Binding BubbleStrokeColor}" StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                <VerticalStackLayout Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding AuthorDisplay}" FontAttributes="Bold"
                                               FontSize="11" TextColor="#2C3E50"/>
                                        <Label Grid.Column="1" Text="{Binding CreatedDisplay}"
                                               FontSize="9" TextColor="#7A8491"/>
                                    </Grid>
                                    <Label Text="{Binding CommentText}" FontSize="13"
                                           TextColor="#202936" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="{Binding MessageColumn}"
                                    IsVisible="{Binding IsProofReturn}"
                                    Padding="13,11" MaximumWidthRequest="380"
                                    BackgroundColor="#FFF8F7" Stroke="#F2C6C2" StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <VerticalStackLayout Spacing="9">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                        <Label Text="↩" FontSize="13" FontAttributes="Bold"
                                               TextColor="#B42318" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="Revision requested"
                                               FontSize="12" FontAttributes="Bold" TextColor="#B42318"
                                               VerticalOptions="Center"/>
                                        <Border Grid.Column="2" WidthRequest="22" HeightRequest="22" Padding="0"
                                                BackgroundColor="#F1DEDC" StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="11"/></Border.StrokeShape>
                                            <Label Text="{Binding ReturnSequenceDisplay}" FontSize="9"
                                                   FontAttributes="Bold" TextColor="#7A271A"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding CommentText}" FontSize="13"
                                           TextColor="#202936" LineBreakMode="WordWrap"/>
                                    <BoxView HeightRequest="1" Color="#F1DEDC"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding AuthorName, StringFormat='Reviewed by {0}'}"
                                               FontSize="9" TextColor="#687786"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1" Text="{Binding CreatedDisplay}"
                                               FontSize="9" TextColor="#7A8491"/>
                                    </Grid>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCommentTapped" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="2" Padding="16,10,16,16"
                             Spacing="7" BackgroundColor="White">
            <Border x:Name="ReadOnlyNotice" IsVisible="False"
                    Padding="12,9" BackgroundColor="#EEF1F4"
                    Stroke="#D7DCE2" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <Label Text="Comments are closed for this task."
                       FontSize="11" TextColor="#687786" HorizontalOptions="Center"/>
            </Border>

            <Border x:Name="CommentComposer" Padding="8,6"
                    BackgroundColor="#F7F8FA" Stroke="#D7DCE2" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Editor x:Name="CommentEditor"
                            Placeholder="Add a comment or note..."
                            PlaceholderColor="#9AA4AF" TextColor="#202936"
                            FontSize="12" AutoSize="TextChanges"
                            MinimumHeightRequest="40" MaximumHeightRequest="100"
                            BackgroundColor="Transparent"/>
                    <Button x:Name="SendButton" Grid.Column="1" Text="Send"
                            Clicked="OnSendClicked" FontSize="11" FontAttributes="Bold"
                            HeightRequest="38" Padding="16,6" CornerRadius="8"
                            BackgroundColor="#243447" TextColor="White"
                            VerticalOptions="End"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
