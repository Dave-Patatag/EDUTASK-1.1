<?xml version="1.0" encoding="utf-8" ?>
<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EDUTASK_1._1.Views.SubtaskProofDraftPage"
             Transition="Dialog"
             BackgroundColor="{StaticResource Scrim}"
             NavigationPage.HasNavigationBar="False">
    <Grid Padding="16">
        <Border x:Name="PopupPanel" WidthRequest="560" HeightRequest="330"
                HorizontalOptions="Center" VerticalOptions="Center"
                Padding="18" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource BorderDefault}">
            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Review file before submission" FontSize="{StaticResource FontHeading}"
                               FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="{Binding SubtaskTitle}" FontSize="{StaticResource FontCaption}" TextColor="{StaticResource Slate400}"
                               LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="&#x2715;" Clicked="OnCloseClicked"
                            WidthRequest="36" HeightRequest="36" Padding="0"
                            FontSize="{StaticResource FontBodySmall}" TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource SurfaceSunken}" CornerRadius="9"
                            SemanticProperties.Description="Close without submitting"/>
                </Grid>

                <Border Grid.Row="1" Padding="0" BackgroundColor="{StaticResource SurfaceBase}" Stroke="{StaticResource BorderDefault}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid RowDefinitions="Auto,*">
                        <Grid Padding="8,9" ColumnDefinitions="28,86,*,54" ColumnSpacing="4"
                              BackgroundColor="{StaticResource SurfaceSunken}">
                            <Label Text="#" FontSize="{StaticResource FontMicro}" FontAttributes="Bold"
                                   TextColor="{StaticResource Slate700}" SemanticProperties.Description="Submission number"/>
                            <Label Grid.Column="1" Text="Date / Time" FontSize="{StaticResource FontMicro}" FontAttributes="Bold" TextColor="{StaticResource Slate700}"/>
                            <Label Grid.Column="2" Text="Proof File" FontSize="{StaticResource FontMicro}" FontAttributes="Bold" TextColor="{StaticResource Slate700}"/>
                            <Label Grid.Column="3" Text="Status" FontSize="{StaticResource FontMicro}" FontAttributes="Bold" TextColor="{StaticResource Slate700}"/>
                        </Grid>
                        <ScrollView Grid.Row="1">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attempts}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid RowDefinitions="Auto,1" ColumnDefinitions="28,86,*,54"
                                              ColumnSpacing="4" Padding="8,9,8,0">
                                            <Label Text="{Binding AttemptDisplay}" FontSize="{StaticResource FontMicro}"
                                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding SubmittedDateDisplay}" FontSize="{StaticResource FontMicro}"
                                                       TextColor="{StaticResource TextSecondary}" MaxLines="1"/>
                                                <Label Text="{Binding SubmittedTimeDisplay}" FontSize="{StaticResource FontMicro}"
                                                       TextColor="{StaticResource Slate400}" MaxLines="1"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding FileName}" FontSize="{StaticResource FontMicro}"
                                                   TextColor="{StaticResource Accent500}" TextDecorations="Underline"
                                                   LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnViewFileTapped"
                                                                          CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Column="3" Text="{Binding ValidationStatus}" FontSize="{StaticResource FontMicro}"
                                                   FontAttributes="Bold" TextColor="{Binding StatusColor}" VerticalOptions="Center"/>
                                            <BoxView Grid.Row="1" Grid.ColumnSpan="4" HeightRequest="1"
                                                     Margin="0,9,0,0" Color="{StaticResource BorderSubtle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

                <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="8">
                    <ImageButton Source="confirmfile.png" Clicked="OnSubmitClicked"
                                 WidthRequest="42" HeightRequest="42" Padding="7"
                                 CornerRadius="9" BackgroundColor="{StaticResource Slate400}"
                                 ToolTipProperties.Text="Submit file"
                                 SemanticProperties.Description="Submit file for review"/>
                    <Button Text="&#x2715;" Clicked="OnRemoveClicked"
                            WidthRequest="42" HeightRequest="42" Padding="0"
                            FontSize="{StaticResource FontBody}" FontAttributes="Bold" CornerRadius="9"
                            BackgroundColor="{StaticResource Slate400}" TextColor="{StaticResource TextInverse}"
                            ToolTipProperties.Text="Remove draft"
                            SemanticProperties.Description="Remove selected draft"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</base:EduTaskPage>
