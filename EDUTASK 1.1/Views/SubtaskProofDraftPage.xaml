<?xml version="1.0" encoding="utf-8" ?>
<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EDUTASK_1._1.Views.SubtaskProofDraftPage"
             Transition="Dialog"
             BackgroundColor="{StaticResource Scrim}"
             NavigationPage.HasNavigationBar="False">
    <Grid Padding="16">
        <Border x:Name="PopupPanel" WidthRequest="560" HeightRequest="236"
                HorizontalOptions="Center" VerticalOptions="Center"
                Padding="14" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource BorderDefault}">
            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding SubtaskTitle}" FontSize="{StaticResource FontHeading}"
                               FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="TailTruncation" MaxLines="2"/>
                        <Label Text="Review file before submission" FontSize="{StaticResource FontCaption}"
                               TextColor="{StaticResource Slate400}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <Border Grid.Row="1" Padding="0" BackgroundColor="{StaticResource SurfaceBase}" Stroke="{StaticResource BorderDefault}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid RowDefinitions="Auto,*">
                        <Grid Padding="6,9" ColumnDefinitions="18,66,*,42,76" ColumnSpacing="3"
                              BackgroundColor="{StaticResource SurfaceSunken}">
                            <Label Text="#" FontSize="{StaticResource FontMicro}" FontAttributes="Bold"
                                   TextColor="{StaticResource Slate700}" SemanticProperties.Description="Submission number"/>
                            <Label Grid.Column="1" Text="Date / Time" FontSize="{StaticResource FontMicro}" FontAttributes="Bold" TextColor="{StaticResource Slate700}"/>
                            <Label Grid.Column="2" Text="Proof Files" FontSize="{StaticResource FontMicro}" FontAttributes="Bold" TextColor="{StaticResource Slate700}"/>
                            <Label Grid.Column="3" Text="Status" FontSize="{StaticResource FontMicro}" FontAttributes="Bold" TextColor="{StaticResource Slate700}"/>
                        </Grid>
                        <ScrollView Grid.Row="1">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attempts}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid RowDefinitions="Auto,1" ColumnDefinitions="18,66,*,42,76"
                                              ColumnSpacing="3" Padding="6,9,6,0">
                                            <Label Text="{Binding AttemptDisplay}" FontSize="{StaticResource FontMicro}"
                                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding SubmittedDateDisplay}" FontSize="{StaticResource FontMicro}"
                                                       TextColor="{StaticResource TextSecondary}" MaxLines="1"/>
                                                <Label Text="{Binding SubmittedTimeDisplay}" FontSize="{StaticResource FontMicro}"
                                                       TextColor="{StaticResource Slate400}" MaxLines="1"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" Padding="5,4"
                                                    HorizontalOptions="Start" VerticalOptions="Center"
                                                    BackgroundColor="Transparent"
                                                    Stroke="{StaticResource Accent500}" StrokeThickness="1">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                                <Label Text="{Binding ViewFilesText}" FontSize="{StaticResource FontMicro}"
                                                       TextColor="{StaticResource Accent500}"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnViewFileTapped"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <Label Grid.Column="3" Text="{Binding ValidationStatus}" FontSize="{StaticResource FontMicro}"
                                                   FontAttributes="Bold" TextColor="{Binding StatusColor}" VerticalOptions="Center"
                                                   LineBreakMode="WordWrap"/>
                                            <HorizontalStackLayout Grid.Column="4" Spacing="4" IsVisible="False"
                                                                   HorizontalOptions="End" VerticalOptions="Center">
                                                <HorizontalStackLayout.Triggers>
                                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding SubmissionID}" Value="0">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </DataTrigger>
                                                </HorizontalStackLayout.Triggers>
                                                <ImageButton Source="proof_submit.png" Clicked="OnSubmitClicked"
                                                             WidthRequest="36" MinimumWidthRequest="36" MaximumWidthRequest="36"
                                                             HeightRequest="38" MinimumHeightRequest="38" MaximumHeightRequest="38"
                                                             Padding="7" CornerRadius="9" BackgroundColor="{StaticResource StatusSuccess}"
                                                             ToolTipProperties.Text="Submit files"
                                                             SemanticProperties.Description="Submit files for review"/>
                                                <ImageButton Source="proof_remove.png" Clicked="OnRemoveClicked"
                                                        WidthRequest="36" MinimumWidthRequest="36" MaximumWidthRequest="36"
                                                        HeightRequest="38" MinimumHeightRequest="38" MaximumHeightRequest="38"
                                                        Padding="7" CornerRadius="9" BackgroundColor="{StaticResource StatusDanger}"
                                                        ToolTipProperties.Text="Remove draft"
                                                        SemanticProperties.Description="Remove selected draft"/>
                                            </HorizontalStackLayout>
                                            <BoxView Grid.Row="1" Grid.ColumnSpan="5" HeightRequest="1"
                                                     Margin="0,9,0,0" Color="{StaticResource BorderSubtle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

                <Button Grid.Row="2" Text="Back" Clicked="OnCloseClicked"
                        HorizontalOptions="Center" HeightRequest="42" MinimumHeightRequest="42"
                        MinimumWidthRequest="80" Padding="18,0" CornerRadius="9"
                        FontSize="{StaticResource FontBodySmall}"
                        BackgroundColor="{StaticResource ActionDismiss}" TextColor="{StaticResource TextInverse}"
                        SemanticProperties.Description="Go back without submitting"/>
            </Grid>
        </Border>
    </Grid>
</base:EduTaskPage>
