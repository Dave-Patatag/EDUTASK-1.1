<base:EduTaskPage xmlns:base="clr-namespace:EDUTASK_1._1.Views.Base" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="EDUTASK_1._1.Views.TeacherSelectionPage"
             Transition="Dialog" NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False"
 BackgroundColor="{StaticResource Scrim}" Padding="20">
 <Border MaximumWidthRequest="460" MaximumHeightRequest="610" HorizontalOptions="Center" VerticalOptions="Center"
         BackgroundColor="{StaticResource SurfaceBase}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" Padding="0">
  <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
   <Grid Padding="18,14,12,10" ColumnDefinitions="*,Auto">
    <Label Text="Select Teachers" FontSize="{StaticResource FontHeading}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
    <Button Grid.Column="1" Text="×" Clicked="OnCancelClicked" WidthRequest="32" HeightRequest="32" Padding="0" FontSize="{StaticResource FontTitle}" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"/>
   </Grid>
   <Border Grid.Row="1" Margin="18,6,18,8" HeightRequest="46" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceMuted}" Padding="10,0">
    <Border.StrokeShape><RoundRectangle CornerRadius="9"/></Border.StrokeShape>
    <Grid ColumnDefinitions="*,Auto"><Entry x:Name="TeacherSearchBar" Placeholder="Search teachers" Style="{StaticResource SearchFieldEntry}" PlaceholderColor="{StaticResource TextDisabled}" TextColor="{StaticResource TextPrimary}" FontSize="{StaticResource FontCaption}" BackgroundColor="Transparent" TextChanged="OnSearchTextChanged"/><Image Grid.Column="1" Source="search.png" WidthRequest="19" HeightRequest="19" Margin="0,0,4,0" VerticalOptions="Center" InputTransparent="True"/></Grid>
   </Border>
   <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="18,2,18,8">
    <Button Text="Select all" Clicked="OnSelectAllClicked" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" FontSize="{StaticResource FontLabel}" FontAttributes="Bold" Padding="0" HorizontalOptions="Start"/>
    <Button Grid.Column="1" Text="Clear" Clicked="OnClearClicked" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" FontSize="{StaticResource FontLabel}" FontAttributes="Bold" Padding="0"/>
   </Grid>
   <CollectionView x:Name="TeachersView" Grid.Row="3" SelectionMode="None" Margin="18,0">
    <CollectionView.EmptyView><Label Text="No teachers found" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,24"/></CollectionView.EmptyView>
    <CollectionView.ItemTemplate><DataTemplate>
     <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" HeightRequest="48" Padding="10,4">
      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Color="{StaticResource Slate400}" VerticalOptions="Center"/>
      <Label Grid.Column="1" Text="{Binding Teacher.DisplayName}" TextColor="{StaticResource TextSecondary}" FontSize="{StaticResource FontBodySmall}" VerticalOptions="Center"/>
     </Grid>
    </DataTemplate></CollectionView.ItemTemplate>
   </CollectionView>
   <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9" Padding="18,10,18,14" BackgroundColor="{StaticResource SurfaceBase}">
    <Label x:Name="SelectionCountLabel" Text="0 selected" TextColor="{StaticResource TextTertiary}" FontSize="{StaticResource FontLabel}" VerticalOptions="Center"/>
    <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="{StaticResource SurfaceSubtle}" TextColor="{StaticResource TextSecondary}" FontSize="{StaticResource FontLabel}" HeightRequest="38" Padding="16,0" CornerRadius="7"/>
    <Button Grid.Column="2" Text="Done" Clicked="OnDoneClicked" BackgroundColor="{StaticResource Slate400}" TextColor="{StaticResource TextInverse}" FontSize="{StaticResource FontLabel}" FontAttributes="Bold" HeightRequest="38" Padding="18,0" CornerRadius="7"/>
   </Grid>
  </Grid>
 </Border>
</base:EduTaskPage>
