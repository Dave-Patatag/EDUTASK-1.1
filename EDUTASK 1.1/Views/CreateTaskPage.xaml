<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="EDUTASK_1._1.Views.CreateTaskPage" NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False"
 BackgroundColor="#99000000" Padding="18">
 <ContentPage.Resources>
  <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="FontSize" Value="11"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="#374151"/></Style>
  <Style x:Key="FieldBorder" TargetType="Border"><Setter Property="BackgroundColor" Value="White"/><Setter Property="Stroke" Value="#D7DCE2"/><Setter Property="StrokeThickness" Value="1"/><Setter Property="Padding" Value="10,3"/><Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="7"/></Setter.Value></Setter></Style>
  <Style x:Key="FieldEntry" TargetType="Entry"><Setter Property="FontSize" Value="12"/><Setter Property="TextColor" Value="#202936"/><Setter Property="PlaceholderColor" Value="#9AA4AF"/><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="HeightRequest" Value="34"/></Style>
 </ContentPage.Resources>
 <Border MaximumWidthRequest="500" MaximumHeightRequest="720" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="White" Stroke="#D7DCE2" StrokeThickness="1" Padding="0">
  <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
  <Grid RowDefinitions="Auto,*,Auto">
   <Grid Padding="16,12" ColumnDefinitions="*,Auto">
    <Label Text="Create New Task" FontSize="18" FontAttributes="Bold" TextColor="#202936" VerticalOptions="Center"/>
    <Button Grid.Column="1" Text="&#x00D7;" Clicked="OnBackTapped" WidthRequest="32" HeightRequest="32" Padding="0" FontSize="20" BackgroundColor="Transparent" TextColor="#4B5563"/>
   </Grid>
   <ScrollView Grid.Row="1">
    <VerticalStackLayout Padding="16,5,16,12" Spacing="9">
     <VerticalStackLayout Spacing="4"><Label Text="Task title" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource FieldBorder}" HeightRequest="46" Padding="10,0"><Entry x:Name="TitleEntry" Style="{StaticResource FieldEntry}" Placeholder="Enter task title" MaxLength="200"/></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="4"><Label Text="Description (optional)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource FieldBorder}" HeightRequest="70" Padding="10,4"><Editor x:Name="DescriptionEditor" Placeholder="Enter task description" PlaceholderColor="#9AA4AF" TextColor="#202936" FontSize="12" AutoSize="Disabled" HeightRequest="58" BackgroundColor="Transparent"/></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="4">
      <Grid ColumnDefinitions="*,Auto"><Label Text="Subtasks" Style="{StaticResource FieldLabel}" VerticalOptions="Center"/><Border Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0" BackgroundColor="#687786" StrokeThickness="0"><Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape><Label Text="+" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAddSubtaskClicked"/></Border.GestureRecognizers></Border></Grid>
      <Border Style="{StaticResource FieldBorder}" Padding="10,2" MinimumHeightRequest="46"><Grid>
       <VerticalStackLayout x:Name="SubtasksContainer" Spacing="0" BindableLayout.ItemsSource="{Binding Subtasks}"><BindableLayout.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" ColumnSpacing="5" HeightRequest="38"><Entry Text="{Binding Title, Mode=TwoWay}" Placeholder="Enter subtask" PlaceholderColor="#9AA4AF" TextColor="#202936" FontSize="12" HeightRequest="36" BackgroundColor="Transparent" MaxLength="200" VerticalOptions="Center"/><Button Grid.Column="1" Text="&#x00D7;" Clicked="OnRemoveSubtaskClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#A84B43" FontSize="15" Padding="0" WidthRequest="28" HeightRequest="28" MinimumHeightRequest="28" VerticalOptions="Center"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
       <Label x:Name="NoSubtasksLabel" Text="No subtasks added" FontSize="12" TextColor="#9AA4AF" Padding="0" Margin="13,0,0,0" HorizontalTextAlignment="Start" HorizontalOptions="Fill" VerticalOptions="Fill" VerticalTextAlignment="Center"/>
      </Grid></Border>
     </VerticalStackLayout>
     <VerticalStackLayout Spacing="4"><Label Text="Due Date" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource FieldBorder}" HeightRequest="46" Padding="10,0"><Grid ColumnDefinitions="*,Auto"><Label x:Name="DueDateDisplayLabel" FontSize="12" TextColor="#374151" VerticalTextAlignment="Center" Margin="13,0,0,0"/><Image Grid.Column="1" Source="calendar.png" WidthRequest="17" HeightRequest="17" Margin="0,0,4,0" VerticalOptions="Center" InputTransparent="True"/><DatePicker x:Name="DueDatePicker" Grid.ColumnSpan="2" Format="MMM dd, yyyy" DateSelected="OnDueDateSelected" Opacity="0.01" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill"/></Grid></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="4"><Label Text="Priority" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource FieldBorder}" HeightRequest="46" Padding="8,0"><Grid ColumnDefinitions="*,Auto"><Picker x:Name="PriorityPicker" SelectedIndexChanged="OnPrioritySelected" FontSize="12" HeightRequest="44" TextColor="#374151" BackgroundColor="Transparent"><Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>Low</x:String><x:String>Medium</x:String><x:String>High</x:String></x:Array></Picker.ItemsSource></Picker><Image Grid.Column="1" Source="dropdown.png" WidthRequest="14" HeightRequest="14" Margin="0,0,7,0" VerticalOptions="Center" InputTransparent="True"/></Grid></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="4"><Label Text="Select Teachers" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource FieldBorder}" HeightRequest="46" Padding="8,0"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Label x:Name="SelectedTeachersLabel" Text="No teachers selected" FontSize="12" TextColor="#7A8491" VerticalOptions="Center" Margin="13,0,0,0" LineBreakMode="TailTruncation"/><Button Grid.Column="1" Text="Select" Clicked="OnSelectTeachersClicked" FontSize="10" FontAttributes="Bold" Padding="13,0" HeightRequest="32" MinimumHeightRequest="32" CornerRadius="6" VerticalOptions="Center" BackgroundColor="#687786" TextColor="White"/></Grid></Border></VerticalStackLayout>
     <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="0" Margin="0,2,0,0" HorizontalOptions="Fill"><Grid ColumnDefinitions="*,52" HeightRequest="42" HorizontalOptions="Fill"><Label Text="Send daily reminders" Style="{StaticResource FieldLabel}" HorizontalOptions="Start" VerticalOptions="Center"/><Switch x:Name="DailyRemindSwitch" Grid.Column="1" OnColor="#687786" ThumbColor="White" WidthRequest="52" MaximumWidthRequest="52" HorizontalOptions="End" VerticalOptions="Center" Margin="0"/></Grid></Border>
    </VerticalStackLayout>
   </ScrollView>
   <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="16,10,16,13" BackgroundColor="White"><Button Text="Cancel" Clicked="OnCancelClicked" FontSize="11" HeightRequest="39" CornerRadius="7" BackgroundColor="#E5E8EB" TextColor="#4B5563"/><Button x:Name="CreateButton" Grid.Column="1" Text="Create Task" Clicked="OnCreateTaskClicked" FontSize="11" FontAttributes="Bold" HeightRequest="39" CornerRadius="7" BackgroundColor="#2563EB" TextColor="White"/></Grid>
  </Grid>
 </Border>
</ContentPage>
