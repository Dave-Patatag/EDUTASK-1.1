<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:EDUTASK_1._1.Views"
       x:Class="EDUTASK_1._1.AppShell"
       FlyoutBehavior="Flyout"
       Shell.NavBarIsVisible="False">

    <Shell.FlyoutHeader>
        <Border Background="{StaticResource BrandGradient}"
                StrokeThickness="0"
                Padding="20,24">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                <!-- The EduTask mark. The full lockup (loginlogo.png) can't sit
                     here: its wordmark ink is this header's own navy, on an
                     opaque white plate. -->
                <Image Grid.Column="0"
                       Source="edutaskmark.png"
                       WidthRequest="42" HeightRequest="42"
                       Aspect="AspectFit"
                       VerticalOptions="Center"
                       SemanticProperties.Description="EduTask"/>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="EduTask"
                           FontSize="{StaticResource FontTitle}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextInverse}"
                           SemanticProperties.HeadingLevel="Level1"/>
                    <Label Text="Task Management System"
                           FontSize="{StaticResource FontCaption}"
                           TextColor="{StaticResource TextInverseMuted}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Shell.FlyoutHeader>

    <!-- Menu Items -->
    <FlyoutItem Title="Menu">
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate views:DirectorStaffDashboardPage}" />
        <ShellContent Title="View All Task" ContentTemplate="{DataTemplate views:ViewTasksPage}" />
        <ShellContent Title="Completed Task" ContentTemplate="{DataTemplate views:CompletedTasksPage}" />
    </FlyoutItem>

</Shell>
