<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android chrome (status bar, task-switcher header, native accents).

        These must track Resources/Styles/Colors.xaml by hand — Android resolves
        this file at build time and never sees the MAUI ResourceDictionary. They
        shipped as the MAUI template purple (#512BD4), which meant the status bar
        was purple on every EduTask screen while the app below it was navy.

        colorPrimary      = Brand800  (the EDUTASK logo navy)
        colorPrimaryDark  = Brand900
        colorAccent       = Green600  (the logo checkmark, accessible step)
    -->
    <color name="colorPrimary">#111C3A</color>
    <color name="colorPrimaryDark">#0A1226</color>
    <color name="colorAccent">#0F7A33</color>
</resources>
